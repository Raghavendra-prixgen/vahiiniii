<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="account_move_form_transportation_order" model="ir.ui.view">
            <field name="name">account_move_inherit_transportation_order</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='other_info']/group[1]/group[@name='sale_info_group']/field[@name='delivery_date']"
                    position="after">
                    <field name="y_gate_management_ids" widget="many2many_tags" readonly="1"/>
                    <field name="y_transportation_order_ids" widget="many2many_tags" readonly="1"/>
                    <field name="y_lr_number" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_form_transportation_order_inherit_atts" model="ir.ui.view">
            <field name="name">sale_order_inherit_transportation_order</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="fleet_module_18.sale_order_form_transportation_order"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='y_transportation_order_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="transportation_order_inherit_invoices" model="ir.ui.view">
            <field name="name">transportation.order.invoice_ids</field>
            <field name="model">transportation.order</field>
            <field name="inherit_id" ref="fleet_module_18.view_fleet_transportation_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='y_company_id']" position="before">
                    <field name="y_invoice_ids" optional="show" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
        <record id="view_fleet_transportation_order_search_invoices" model="ir.ui.view">
            <field name="name">transportation.order.invoices</field>
            <field name="model">transportation.order</field>
            <field name="inherit_id" ref="fleet_module_18.view_fleet_transportation_order_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='y_fwd_agent']" position="after">
                    <field name="y_invoice_name" string="invoices"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>        
            