<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_company_view_form_inherit_custom" model="ir.ui.view">
            <field name="name">res.company.view.form.inherit.custom</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='color']" position="after">
                    <field name="y_is_registered_company"></field>
                </xpath>

            </field>
        </record>


    </data>


</odoo>
