<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record model="ir.ui.view" id="view_inherited_of_res_partner">
        <field name="name">inherit.view.res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="property_product_pricelist" position="after">
                <label for="y_average_collection_days" />
                <div>
                    <field name="y_average_collection_days" class="oe_inline" />
                    <button type="object" name="action_calculate_average_collection_days"
                        title="Calculate Average Collection Days" string="Calculate" />
                </div>
            </field>
        </field>
    </record>


   

    <record model="ir.ui.view" id="custom_customer_statements_tree_view">
        <field name="name">custom.inherit.view.res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_followup_addon.customer_statements_tree_view" />
        <field name="arch" type="xml">
            <field name="followup_responsible_id" position="after">
                <field name="y_team_id"  optional="hide"/>
                <field name="y_partner_category" optional="hide"/>
            </field>

            <field name="followup_responsible_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

             <field name="followup_reminder_type" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="followup_status" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="followup_next_action_date" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="followup_line_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="total_due" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="total_overdue" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="company_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="activity_ids" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>








          
        </field>
    </record>


    <record id="ir_action_update_average_collection" model="ir.actions.server">
        <field name="name">Update Average Collection Days</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.action_calculate_average_collection_days()
        </field>
        <field name="binding_model_id" ref="model_res_partner" />
    </record>


</odoo>