<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_only_form_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.template</field>
        <field name="mode">primary</field>
        <field name="priority" eval="8" />
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='responsible_id']" position="after">
                <field name="y_min_thickness" label="Minimum Thickness" />
                <field name="y_max_thickness" label="Maximum Thickness" />
                <field name="y_prod_length" />
            </xpath>
            <xpath expr="//field[@name='y_product_classification_id']" position ="after" >
                <field name = "y_retail_print_product" />
            </xpath>
        </field>
    </record>


    <record id="product_form_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_valuated']" position ="after" >
                <field name = "y_retail_print_product" />
            </xpath>
        </field>
    </record>
</odoo>