<!-- <?xml version="1.0" encoding="UTF-8"?> -->
<odoo>
    <record id="department_stock_view_tree" model="ir.ui.view">
        <field name="name">department_stock.view.tree</field>
        <field name="model">department.stocks</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="y_departments" />
            </list>
        </field>
    </record>

    <record id="expense_stocks_view_tree" model="ir.ui.view">
        <field name="name">expense_stocks.view.tree</field>
        <field name="model">expense.stocks</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="y_expenses" />
            </list>
        </field>
    </record>


    <record id="department_stock_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">department.stocks</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="expense_stocks_action" model="ir.actions.act_window">
        <field name="name">Expense Type</field>
        <field name="res_model">expense.stocks</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="stock_picking_type_menu"
        name="Departments"
        action="department_stock_action"
        parent="stock.menu_stock_config_settings"
        sequence="6" />

    <menuitem id="expense_stocks_type_menu"
        name="Expense Type"
        action="expense_stocks_action"
        parent="stock.menu_stock_config_settings"
        sequence="4" />


</odoo>        
           