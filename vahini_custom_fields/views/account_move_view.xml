<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="view_fleet_fields_account_move_form">
        <field name="name">account.move.add.custom.fields.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='other_info']/group[1]/group[@name='sale_info_group']/field[@name='delivery_date']"
                position="after">
                <field name="y_confirmation_date" />
                <field name="y_delivered_to" />
                <field name="y_proforma_sequence" />
                <field name="y_custom_po_no" />
                <field name="y_po_date" />
                <field name="y_transporter" />
            </xpath>

            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="required">move_type in ('in_invoice')</attribute>
            </xpath>

            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='other_info']/group[1]" position="after">
                <group name="farmer_info" string="Farmer Details">
                    <field name="y_farmer_share" invisible="move_type not in ('out_invoice')"/>
                    <field name="y_government_share" invisible="move_type not in ('out_invoice')"/>
                    <field name="y_custom_farmer_share" invisible="move_type not in ('out_invoice')"/>
                </group>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="inherit_view_account_move_tree">
        <field name="name">inherit.view.account.move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="paid_date" />
            </xpath>
        </field>
    </record>


</odoo>