<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <record model="ir.ui.view" id="packing_category_tree">
        <field name="name">List View For Packing Category</field>
        <field name="model">packing.category</field>
        <field name="arch" type="xml">
          <list>
            <field name="y_name"/>
          </list>              
        </field>
      </record>
  
    <record model="ir.ui.view" id="packing_category_form">
        <field name="name">Form View For Packing Category</field>
        <field name="model">packing.category</field>
        <field name="arch" type="xml">
            <form>
            <sheet>
                <group>
                <group>
                    <field name="y_name" required="1"/>
                </group>
                <group>
                
                </group>
                </group>
            </sheet>
            <chatter/>
            </form>
        </field>
    </record>


    <record id="packing_category_action" model="ir.actions.act_window">
        <field name="name">Packing Category</field>
        <field name="res_model">packing.category</field>
        <field name="view_mode">list,form</field>
    </record>
  
    <menuitem
        name="Packaging Category" id="packing_category_menu"
        parent="stock.menu_product_in_config_stock"
        action="packing_category_action" />


        <record model="ir.ui.view" id="stock_package_type_category_form_inherit">
            <field name="name">stock.package.type.category.form.inherit</field>
            <field name="model">stock.package.type</field>
            <field name="inherit_id" ref="stock.stock_package_type_form"/>
            <field name="arch" type="xml">
                <field name="barcode" position="after">
                    <field name="y_packing_category_id" />
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="stock_package_type_category_list_inherit">
            <field name="name">stock.package.type.category.list.inherit</field>
            <field name="model">stock.package.type</field>
            <field name="inherit_id" ref="stock.stock_package_type_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="y_packing_category_id" />
                </xpath>
            </field>
        </record>
        


        <record id="vahini_account_move_form_copy" model="ir.ui.view">
            <field name="name">account.move.vahini.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='l10n_in_type_id']" position="after">
                    <field name="y_e_way_doc_no" String="E-Way Bill Document No"/>
                </xpath>
                <xpath expr="//form//sheet//notebook/page/field[@name='invoice_line_ids']//list/field[@name='y_stock_move_id']" position="after">
                    <field name="y_packing_category_id" column_invisible="1"/>
                </xpath>
            
            </field>
        </record>

