        <record model="ir.ui.view" id="view_form_product_template_inherit">
            <field name="name">product.packaging.list.inherit</field>
            <field name="model">product.packaging</field>
            <field name="inherit_id" ref="product.product_packaging_tree_view2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='package_type_id']" position="after">
                    <field name="y_packing_category_id"/>
                </xpath>
            </field>
        </record>

        






        <record model="ir.ui.view" id="view_form_stock_move_inherit">
            <field name="name">stock.picking.list.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                 <xpath expr="//field[@name='location_id'][1]" position="attributes">
                         <attribute name="invisible">picking_type_code in ('incoming','internal')</attribute>
                     </xpath>
                     <xpath expr="//field[@name='location_dest_id'][1]" position="attributes">
                         <attribute name="invisible">picking_type_code in ('outgoing','internal')</attribute>
                     </xpath>
                     <xpath expr="//field[@name='location_id'][2]" position="attributes">
                         <attribute name="invisible">picking_type_code in ('incoming','internal')</attribute>
                     </xpath>
                     <xpath expr="//field[@name='location_dest_id'][2]" position="attributes">
                         <attribute name="invisible">picking_type_code in ('outgoing','internal')</attribute>
                     </xpath>
                     <field name="picking_type_id" position="after">

                   <field name="location_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" invisible="picking_type_code != 'internal'" domain="[('usage', '=', 'internal')]" readonly="state == 'done'"/>
                    <field name="location_dest_id" domain="[('usage', '=', 'internal')]" options="{'no_create': True}" groups="stock.group_stock_multi_locations" invisible="picking_type_code != 'internal'" readonly="state == 'done'"/>
                    </field>

                    <xpath expr="//field[@name='picking_type_id']" position="attributes">
                   <attribute name="invisible">picking_type_code == 'internal' </attribute>
                 </xpath>

                   

                   <field name="partner_id" position="after">
                            
                    <field name="picking_type_id" invisible="picking_type_code != 'internal'" options="{'no_open': True}" readonly="state in ('done', 'cancel')" domain="[('code', '=', 'internal')]"/>
                    </field> 




                <xpath expr="//form//sheet//notebook/page/field[@name='move_ids_without_package']//list/field[@name='product_packaging_id']" position="after">
                    <field name="y_packing_category_id" column_invisible="1"/>
                </xpath>
                
            </field>
        </record>

        <record model="ir.ui.view" id="view_form_stock_picking_inherit_tree">
            <field name="name">stock.picking.list.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                  <xpath expr="//list" position="attributes">
                      <attribute name="default_order">create_date desc</attribute>
                  </xpath>
                
            </field>
        </record>

         <record model="ir.ui.view" id="view_form_stock_move_inherit_order_tree">
            <field name="name">stock.move.list.inherit</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_tree"/>
            <field name="arch" type="xml">
                  <xpath expr="//list" position="attributes">
                      <attribute name="default_order">create_date desc</attribute>
                  </xpath>
                
            </field>
        </record>



        


