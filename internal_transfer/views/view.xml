<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="account_payment_form_internal_transfer_view" model="ir.ui.view">
        <field name="name">account.payment.form.is.internal.transfer.view</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']/group/field[@name='payment_type']" position="before">
                <field name="paired_internal_transfer_payment_id" invisible="1"/>
                <label for="is_internal_transfer"/>
                <div>
                    <field name="is_internal_transfer" readonly="state != 'draft'"/>
                    <span invisible="paired_internal_transfer_payment_id or not is_internal_transfer or state != 'draft'"
                          class="fst-italic">
                        A second payment will be created in the destination journal.
                    </span>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id'][1]" position="attributes">
                <attribute name="invisible">partner_type != 'customer' or is_internal_transfer</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][2]" position="attributes">
                <attribute name="invisible">partner_type != 'supplier' or is_internal_transfer</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_bank_id'][1]" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or partner_type != 'customer' or payment_type == 'inbound' or is_internal_transfer</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or partner_type != 'supplier' or payment_type == 'inbound' or is_internal_transfer</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_bank_id'][3]" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or payment_type == 'outbound' or is_internal_transfer</attribute>
            </xpath>

            <xpath expr="//group[@name='main_group']/group[@name='group2']" position="inside">
                <field name="destination_journal_id"
                                       placeholder="e.g. Cash"
                                       context="{'default_partner_id': partner_id}"
                                       invisible="not is_internal_transfer"
                                       readonly="state != 'draft'"
                                       required="is_internal_transfer and state == 'draft'"/>

            </xpath>

            
        </field>
    </record>

</odoo>
