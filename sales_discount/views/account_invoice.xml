<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="invoice_form_customer_inherit" model="ir.ui.view">
        <field name="name">account.invoice.supplier.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="merge_product_discount" type="object" string="Calculate Discount" style="text-transform: capitalize;" invisible="y_cal_done == True or move_type not in ('out_invoice')"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                   <field name="y_category_id" readonly="1"/>
            </xpath>
            <!-- <xpath expr="//page[@id='other_tab']//field[@name='fiscal_position_id']" position="after">
                <field name='y_account_enty_id'/>
            </xpath> -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="before">
                <field name="y_trade_discount_amt" column_invisible="parent.move_type not in ('out_invoice')" optional="show"/>
                <field name="y_quantity_discount_amt" column_invisible="parent.move_type not in ('out_invoice')" optional="show"/>
                <field name="y_specual_discount_amt" column_invisible="parent.move_type not in ('out_invoice')" optional="show"/>
                <field name="y_total_discount_amt"  column_invisible="parent.move_type not in ('out_invoice')" optional="show" sum="Total Discount"/>
                <field name="y_is_discount_record" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="before" > 
                <field name="y_trade_discount_amt" column_invisible="True"/>
                <field name="y_quantity_discount_amt" column_invisible="True"/>
                <field name="y_specual_discount_amt" column_invisible="True"/>
                <field name="y_trade_discounts" column_invisible="True"/>
                <field name="y_special_discount" column_invisible="True"/>
                <field name="y_quantity_discount" column_invisible="True"/>
                <field name="y_alt_uom" column_invisible="True"/>
                <field name="y_total_discount_amt" column_invisible="True"/> 
                <field name="y_is_discount_record" column_invisible="True"/> 
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="y_tot_inv_discount_amt" invisible="move_type not in ('out_invoice')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
              <page string="Invoice Discounts" name="discount" invisible="move_type not in ('out_invoice')">
                <field name="y_invoice_dis_line_ids">
                  <list string="Discount Lines" editable="bottom" delete="0">
                    <field name="y_category" readonly="1"/>
                    <field name="y_currency_id" column_invisible="True"/>
                    <field name="y_amount" sum="Total amount"/>
                    <field name="y_trade_discount_id" column_invisible="True"/>
                    <field name="y_trade_discounts" readonly='1' force_save="1" />
                    <field name="y_trade_amount" sum="Total Trade Discount amount"/>
                    <field name="y_quantity_discount_id" column_invisible="True"/>
                    <field name="y_quantity_discount" readonly='1' force_save="1"/>
                    <field name="y_quantity_amount" sum="Total Quantity Discount amount"/>
                    <field name="y_special_discount_id" column_invisible="True"/>
                    <field name="y_special_discount" readonly='1' />
                    <field name="y_special_amount" sum="Total Special Discount amount"/>
                    <field name="y_total_discount_amount" sum="total_discount_amount"/>
                  </list>
                </field>
              </page>
            </xpath>
        </field>
    </record>
</odoo>
