<odoo>

	<record id="tree_stock_valuation_layer_account_valuation_balance" model="ir.ui.view">
	    <field name="name">tree.stock.valuation.layer.account.valuation.balance</field>
		<field name="model">stock.valuation.layer</field>
		<field name="inherit_id" ref="stock_account.stock_valuation_layer_tree" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='value']" position="after">
			    <field name="y_account_valuation_balance" optional="hide" readonly="1"/>
			    <field name="y_diffrence" optional="hide" readonly="1"/>
			    <field name="y_ledger_id" optional="hide"  readonly="1"/>
			</xpath>
		</field>
	</record>
</odoo>