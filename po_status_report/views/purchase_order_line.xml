<odoo>
    <data>
        <record model="ir.ui.view" id="search_purchase_order_line_button">
            <field name="name">purchase.order.line.search.inherited</field>
            <field name="model">purchase.order.line</field>
            <field name="inherit_id" ref="purchase.purchase_order_line_search"/>
            <field name="arch" type="xml">
                <search>
                    <field name="y_pending_qty" invisible="1"/>
                    <field name="order_id"/>
                    <filter name="archived" string="Open Orders" domain="[('y_pending_qty', '>', 0)]"/>
                    <searchpanel>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="sh_pol_purchase_order_line_tree_view_inherit" model="ir.ui.view">
            <field name="name">Purchase Order Line Tree</field>
            <field name="model">purchase.order.line</field>
            <field name="arch" type="xml">
                <list create="false" action="purchase_order_view" type="object">
                    <field name="order_id" string="Order"/>
                    <field name="product_id"/>
                    <field name="name" optional="hide"/>
                    <field name="partner_id"/>
                    <field name="y_product_categ" optional="hide"/>
                    <field name="date_order" string="Order Confirm Date" optional="show" options="{'show_time': false}"/>
                    <field name="y_effective_date" optional="hide" string="Effective date" options="{'show_time': false}"/>
                    <field name="date_approve" optional="hide" string="Approve date" options="{'show_time': false}"/>



                    <field name="date_planned" widget="date"/>
                    <field name="product_qty" string="Quantity"/>
                    <field name="qty_received"/>
                    <field name="qty_invoiced"/>
                    <field name="y_pending_qty" string="Pending Quantity(GRN)"/>
                    <field name="y_pending_value" string="Pending Value(GRN)" sum="Total"/>
                    <field name="y_bill_pending_qty" string="Pending Quantity(Bill)"/>
                    <field name="y_bill_pending_value" string="Pending Value(Bill)" sum="Total"/>
                    <field name="price_unit"/>
                    <field name="company_id" optional="hide"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="taxes_id" widget="many2many_tags" optional="hide"/>
                    <field name="price_subtotal" sum="Total" string="Untaxed Amount"/>
                    <field name="y_doc_type_id"/>
                    <field name="y_status"/>
                    <field name="y_receipt_status"/>
                    <field name="y_is_short_close" optional="hide"/>
                    <field name ="y_short_close_description" optional="hide"/>
                    <field name="y_invoice_status" widget = "badge" decoration-success="y_invoice_status == 'full'" decoration-info="y_invoice_status == 'waiting'" decoration-muted="y_invoice_status == 'no_bill'" class="text-dark"/>
                    <field name="state" optional="hide" widget="badge" decoration-success="state == 'purchase' or state == 'done'" decoration-warning="state == 'to approve'" decoration-info="state == 'draft' or state == 'sent'"/>
                </list>
            </field>
        </record>


        <record id="sh_action_purchase_order_lines" model="ir.actions.act_window">
            <field name="name">Purchase Order Status</field>
            <field name="res_model">purchase.order.line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list,pivot</field>
            <field name="target">current</field>
            <field name="domain">[('state','in',('purchase','done'))]</field>
            <field name="view_id" ref="sh_pol_purchase_order_line_tree_view_inherit"/>
        </record>


        <record model="ir.actions.server" id="action_short_close_pol">
            <field name="name">Short Close</field>
            <field name="model_id" ref="purchase.model_purchase_order_line"/>
            <field name="binding_model_id" ref="purchase.model_purchase_order_line"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.short_close_form_wizard_pol()
            </field>
          </record>

        <menuitem id="sh_pol_order_line" name="Purchase Order Status" action="sh_action_purchase_order_lines"
                  parent="purchase.purchase_report"/>

        <menuitem id="sh_purchase_report" name="Purchase Analysis" parent="purchase.purchase_report" sequence="99"
                  groups="purchase.group_purchase_manager" action="purchase.action_purchase_order_report_all"/>

    </data>
</odoo>
