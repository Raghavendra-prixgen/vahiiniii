<odoo>
    <record id="yield_analysis_email_template" model="mail.template">
        <field name="name">Yield analysis report</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="subject">Your Yield Analysis Report {{ object.name }}</field>
        <field name="auto_delete" eval="False"/>
        <!-- <field name="active" eval="True"/> -->
        <field name="lang">${user.lang}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <div style="margin:0px;padding: 0px;">
                    <span>Dear Team,</span><br/>
                    <span>Please find your yield analysis report for manufacturing order</span>
                    <strong t-out="(object.name)"/>
                </div>
            </div>
        </field>
    </record>

    

</odoo>