<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_auto_lot_configuration_tree" model="ir.ui.view">
        <field name="name">auto.lot.configuration.tree</field>
        <field name="model">auto.lot.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_category_id"/>
                <field name="prefix"/>
                <field name="sequence_size"/>
                <field name="use_po_number"/>
                <field name="use_grn_number"/>
                <field name="use_vendor_ref"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_auto_lot_configuration_form" model="ir.ui.view">
        <field name="name">auto.lot.configuration.form</field>
        <field name="model">auto.lot.configuration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_category_id"/>
                            <field name="prefix"/>
                            <field name="sequence_size"/>
                        </group>
                        <group>
                            <field name="use_po_number"/>
                            <field name="use_grn_number"/>
                            <field name="use_vendor_ref"/>
                            <field name="sequence_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_auto_lot_configuration" model="ir.actions.act_window">
        <field name="name">Auto Lot Configuration</field>
        <field name="res_model">auto.lot.configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="auto_lot_creation_18.view_auto_lot_configuration_tree"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_auto_lot_configuration"
              name="Auto Lot Configuration"
              action="action_auto_lot_configuration"
              parent="stock.menu_stock_config_settings"
              sequence="100"/>
</odoo>