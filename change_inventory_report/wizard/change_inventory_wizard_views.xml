<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════
         Wizard Form View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_change_inventory_wizard_form" model="ir.ui.view">
        <field name="name">change.inventory.wizard.form</field>
        <field name="model">change.inventory.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Inventory Report">
                <group>
                    <group>
                        <field name="y_date_from" required="1"/>
                        <field name="y_company_id" options="{'no_create': True, 'no_open': True}" required="1"/>

                    </group>
                    <group>
                        <field name="y_date_to"  required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Wizard Action (opens as dialog)
    ═══════════════════════════════════════════════════════ -->
    <record id="action_change_inventory_wizard" model="ir.actions.act_window">
        <field name="name">Change Inventory Report</field>
        <field name="res_model">change.inventory.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_change_inventory_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
