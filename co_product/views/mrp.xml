  <record id="mrp_bom_form_view" model="ir.ui.view">
    <field name="name">mrp.bom.inherit.view.form</field>
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">
      <page name="by_products" position="after">
        <page name="co_products" string="Co-Products">
          <field name="y_coproduct_ids">
            <list editable="bottom">
              <field name="y_product_id" options="{'no_create': True,'no_edit':True}"/>
              <field name="y_product_uom_id" options="{'no_create': True,'no_edit':True}"/>
              <field name="y_product_qty" />

            </list>
          </field>
        </page>
      </page>
    </field>
  </record>



  <record id="mrp_production_form_view_co_products" model="ir.ui.view">
    <field name="name">mrp_production_form_view_co_products</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='operations']" position="inside">
        <field name = "y_co_prod_mo_id" invisible="1" options="{'no_create': True,'no_edit':True}"/>
      </xpath>
      <xpath expr="//page[@name='miscellaneous']/group/group/field[@name='origin']" position="after">
        <field name="y_co_prod_mo_id" invisible="1" options="{'no_create': True,'no_edit':True}"/>
      </xpath>
      <xpath expr="//page[@name='miscellaneous']/group/group/field[@name='origin']"  position="replace">
        <field name="origin" readonly="y_co_prod_mo_id != False"/>
      </xpath>
      <xpath expr="//form/sheet/div[@name='button_box']/button[@name='action_view_mrp_production_childs']" position="after">
        <field name="y_co_product_track" invisible="1"/>
        <field name="y_co_product_count" invisible="1"/>
        <button class="oe_stat_button" name="action_view_coproduct_views" type="object" icon="fa-wrench" invisible=" y_co_product_track == False">
          <field name="y_co_product_count" widget="statinfo"  string="Co Product"/>
        </button>
      </xpath>
      <page name="finished_products" position="after">
          <page name="co_products" string="Co-Products" >
            <field name="y_co_prod_ids">
              <list editable="bottom">
                <field name="y_product_id" options="{'no_create': True,'no_edit':True}"/> 
                <field name="y_product_uom_id" options="{'no_create': True,'no_edit':True}"/>
                <field name="y_co_lot_id" readonly="1"/>
                <field name="y_product_qty" />
                <field name="y_bomlineboolean" column_invisible="1"/>
                <field name="y_co_prod_mo_id" column_invisible="1"/>
                <field name="y_state" column_invisible="1"/>
                <button name="action_process" string="Process" type="object" class="oe_highlight" invisible="1"/>
                <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="1"/>
                <button name="button_mark_done" string="Mark as Done" type="object" class="oe_highlight" invisible= "1"/>
              </list>
            </field>
          </page>
      </page>

    </field>
  </record>
</odoo>