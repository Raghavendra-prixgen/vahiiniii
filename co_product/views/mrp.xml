<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_co_product_sequences" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.co.product.sequence</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="mrp_lock" position="after">
              <div class="col-12 col-lg-6 o_setting_box" id="co_product_format_setting">
                <div class="o_setting_right_pane" id="co_prod_seq_id">
                    <span class="o_form_label">Co-Product</span>
                    <div class="text-muted">
                      Set the sequence format for Co Product
                    </div>
                    <div class="content-group" id="boe_sequence_id_seq">
                        <div class="mt16 row">
                            <label for="y_co_prod_seq_id" string="Co-Product Sequence" class="col-3 col-lg-3 o_light_label"/>
                            <field name="y_co_prod_seq_id" class="oe_inline" required="0" options="{'no_create': True, 'no_create_edit':True}"/>
                        </div>
                        <div class="mt16 row">
                            <label for="y_co_lot_seq_id" string="Co-Product Lot Sequence" class="col-3 col-lg-3 o_light_label"/>
                            <field name="y_co_lot_seq_id" class="oe_inline" required="0" options="{'no_create': True, 'no_create_edit':True}"/>
                        </div>
                    </div>

                </div>
              </div>
            </setting>
        </field>
    </record>

