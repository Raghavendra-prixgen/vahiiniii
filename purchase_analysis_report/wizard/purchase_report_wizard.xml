<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_purchase_report_analysis_wizard" model="ir.ui.view">
            <field name="name">purchase.analysis.wizard</field>
            <field name="model">purchase.analysis.wizard</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <group>
                                <field name="y_start_date" string="Start Date" required='1' />
                            </group>
                            <group>
                                <field name="y_end_date" string="End Date" required='1' />
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <group>
                            <button class="btn btn-primary" type="object" name="retrieve_register"
                                string="View Register" />
                        </group>
                    </footer>
                    
                </form>
            </field>
        </record>
    </data>

</odoo>