<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_confirm_credit_sale_credit_approval_wizard_message" model="ir.ui.view">
        <field name="name">confirm.sale.credit.approval.wizard.form</field>
        <field name="model">confirm.sale.credit.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="warnin">
                <sheet>
                    <group>
                        <group>
                            <field name="y_credit_amount" readonly="1"/>
                        </group>
                    </group>
                    <field name="y_message" readonly="1"/>
                    <field name="y_message_html" readonly="1"/>
                    <br/>
                    <field name="y_sale_id" invisible="1"/>
                </sheet>
                <footer>
                    <button string="Request for Approval" name="action_confirm" type="object" class="btn-primary" invisible="y_is_bypass_credit_limit"/>
                    <button name="action_sale_order_confirm" class="btn-primary" string="Confirm" type="object" invisible="not y_is_bypass_credit_limit"/>                    
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_credit_sale_approval_form" model="ir.ui.view">
        <field name="name">credit.sale.approval.form</field>
        <field name="model">credit.sale.approval</field>
        <field name="arch" type="xml">
          <form string="Sales Approval" >
            <sheet>
                <group>
                    <group>
                        <field name="y_company_id" invisible="1"/>
                        <field name="y_parent_company_id" invisible="1"/>
                        <field name="y_document_type_id" required="1" options="{'no_create': True, 'no_open': True}" domain="['|','|','|',('y_company_id', '=', False),('y_company_id', 'child_of', y_company_id),('y_company_id', '=', y_company_id),('y_company_id', '=', y_parent_company_id)]"/>
                        <field name="y_name" required="1"/>
                    </group>
                    <group>
                        <field name="y_company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" groups="base.group_multi_company" required="1"/>
                        <field name="y_currency_id" options="{'no_create': True, 'no_create_edit':True,'no_open':True}" required="1"/>
                    </group>
                <group>
                </group>
                </group>
                    <notebook>
                        <page string="Approvals" name="lvlandamount">
                            <field name="y_lvl_amt_approval_lines" widget="section_and_note_one2many" >
                                <list string="Lvl and Amt Approval Lines" editable="bottom">
                                    <field name='y_approval_level' required="1"/>
                                    <field name='y_approval_amount_from' required="1"/>
                                    <field name='y_approval_amount_to' required="1"/>
                                    <field name='y_lvl1_user_id' options="{'no_create': True, 'no_open': True}" required="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval','4thlvlapproval','5thlvlapproval')"/>
                                    <field name='y_lvl2_user_id' options="{'no_create': True, 'no_open': True}" required="y_approval_level in ('2ndlvlapproval','3rdlvlapproval','4thlvlapproval','5thlvlapproval')" force_save="1" readonly="y_approval_level == '1stlvlapproval'"/>
                                    <field name='y_lvl3_user_id' options="{'no_create': True, 'no_open': True}" required="y_approval_level in ('3rdlvlapproval','4thlvlapproval','5thlvlapproval')" force_save="1" readonly="y_approval_level in ('1stlvlapproval','2ndlvlapproval')"/>
                                    <field name='y_lvl4_user_id' options="{'no_create': True, 'no_open': True}" required ="y_approval_level in ('4thlvlapproval','5thlvlapproval')" force_save="1" readonly ="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval')"/>
                                    <field name='y_lvl5_user_id' options="{'no_create': True, 'no_open': True}" force_save="1" readonly ="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval','4thlvlapproval')" required="y_approval_level == '5thlvlapproval'"/>
                                    
                                    <field name='y_lvl_approval_id' column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
            </sheet>
            <chatter/>
          </form>
        </field>
    </record>

    <record id="view_credit_sale_approval_form_tree" model="ir.ui.view">
        <field name="name">credit.sale.approval.list</field>
        <field name="model">credit.sale.approval</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <list string="Sales Approval" >
                <field name="y_name"/>
                <field name="y_company_id"/>
                <field name="y_currency_id"/>
            </list>
        </field>
    </record>

    <record id="view_credit_sale_approval_search_view" model="ir.ui.view">
        <field name="name">credit.sale.approval.search</field>
        <field name="model">credit.sale.approval</field>
        <field name="arch" type="xml">
            <search>
                <field name="y_name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record model="ir.rule" id="crdit_sale_approval_record_restricted_company_rule">
        <field name="name">Credit Sale Approval Restricted Record: multi-company</field>
        <field name="model_id" ref="model_credit_sale_approval"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('y_company_id', '=', False), ('y_company_id', 'parent_of', company_ids)]
        </field>
    </record>

   

    <record id="action_credit_sale_approval" model="ir.actions.act_window">
        <field name="name">Credit Approval Setting SO</field>
        <field name="res_model">credit.sale.approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
        id="menu_credit_sale_approval" 
        name="Credit Approval Setting SO" 
        parent="sale_base_18.menu_config_sale_others"
        action="action_credit_sale_approval" sequence="150"
    />

    <!-- ===================# Sale Approval Configuration END #======================= -->


    <!-- ===================# Sale Approval in Sale Order #======================= -->
    
</odoo>