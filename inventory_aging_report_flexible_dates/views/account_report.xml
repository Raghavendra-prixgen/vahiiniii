        <field name="period_2_qty" optional="show"/>
        <field name="period_2_value" optional="show" groups="inventory_aging_report_flexible_dates.aging_value_access_group"/>
        <field name="period_3_qty" optional="show"/>
        <field name="period_3_value" optional="show" groups="inventory_aging_report_flexible_dates.aging_value_access_group"/>
        <field name="period_4_qty" optional="show"/>
