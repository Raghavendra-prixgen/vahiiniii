  <record id="view_inventory_aging_value_report_filter" model="ir.ui.view">
    <field name="name">inventory.aging.qty.value.report.search.view</field>
    <field name="model">inventory.aging.qty.value.report</field>
    <field name="arch" type="xml">
        <search string="Search">
            <field name="product_id" string="Product"/>
            <field name="product_category_id"/>
            <field name="lot_id"/>
            <group expand="0" string="Group By">
              <filter name="positive_values" string="Negative value filter" domain="[('value','>=',0)]"/>
              <filter name="product_id" string="Product" domain="[]" context="{'group_by':'product_id'}"/>
              <filter name="product_category_id" string="Product Category" domain="[]" context="{'group_by':'product_category_id'}"/>
            </group>
       </search>
    </field>
  </record>
</odoo>
