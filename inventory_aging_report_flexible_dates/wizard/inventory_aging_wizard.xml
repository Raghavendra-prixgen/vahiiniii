<odoo>
  
    <record id="view_inventory_aging_value_wizard" model="ir.ui.view">
        <field name="name">inventory.aging.value.wizard.form</field>
        <field name="model">inventory.aging.value.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_start" required="1"/>
                        <label for="period_1_to" string="Period 1"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_1_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_1_to"/>
                        </div>
                        <label for="period_2_to" string="Period 2"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_2_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_2_to"/>
                        </div>
                        <label for="period_3_to" string="Period 3"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_3_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_3_to"/>
                        </div>
                        <label for="period_4_to" string="Period 4"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_4_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_4_to"/>
                        </div>
                        <label for="period_5_to" string="Period 5"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_5_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_5_to"/>
                        </div>
                        <label for="period_6_to" string="Period 6"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_6_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_6_to"/>
                        </div>
                        <label for="period_7_to" string="Period 7"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_7_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_7_to"/>
                        </div>
                        <label for="period_8_to" string="Period 8"/>
                        <div class="d-flex flex-row gap-4">
                            <div class="d-flex flex-row gap-1">
                                <field name="period_8_from" force_save="1" readonly="1"/>
                                <strong><span style="padding-left:5px;">-</span></strong>
                            </div>
                            <field name="period_8_to"/>
                        </div>
                    </group>
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" required="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Report" type="object" name="button_view_report" class="oe_highlight"/>
                    <button string="Generate Xlsx Report" type="object" name="button_download_xlsx_report" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" type="object" class="btn btn-secondary oe_inline"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_inventory_aging_value_report_wizard" model="ir.actions.act_window">
       <field name="name">Inventory Ageing Report</field>
       <field name="res_model">inventory.aging.value.wizard</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
       <field name="view_id" ref="view_inventory_aging_value_wizard"/>
    </record> 

    <menuitem id="inventory_aging_value_report_menu" name="Inventory Ageing Report(Quantity/Value)" parent="stock.menu_warehouse_report" action="action_inventory_aging_value_report_wizard" sequence="100"/>

</odoo>
