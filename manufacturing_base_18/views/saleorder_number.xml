    <record id="stock_picking_salenumber_tree_inherit_" model="ir.ui.view">
        <field name="name">stock.picking.list.view.inherit.sale.no.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="y_sale_order_id" string="Sale Order"/>
            </field>
        </field>
    </record>

