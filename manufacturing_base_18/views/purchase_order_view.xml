<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="purchase_order_form_inherit_sale_order_production" model="ir.ui.view">
		<field name="name">purchase.order.form.inherit.so.origin</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form"/>
		<field name="arch" type="xml">
			<field name="origin" position="after">
				<field name="y_sale_order_id" string="Sale Order"/>
			</field>
		</field>
	</record>

	<record id="view_purchase_order_search_inherited_sale_number" model="ir.ui.view">
		<field name="name">purchase.order.search.inherited</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
		<field name="arch" type="xml">
			<search>
				<field name="y_sale_order_id" string="Sale Order"/>
			</search>
		</field>
	</record>


	<record id="purchase_order_salenumber_tree_inherit" model="ir.ui.view">
		<field name="name">purchase.order.list.view.inherit.sale.no.view</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
		<field name="arch" type="xml">
			<field name="origin" position="after">
				<field name="y_sale_order_id" string="Sale Order" />
			</field>
		</field>
	</record>

	<record id="purchase_order_salenumber_tree_inherit" model="ir.ui.view">
		<field name="name">purchase.order.list.view.inherit.sale.no.view</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
		<field name="arch" type="xml">
			<field name="origin" position="after">
				<field name="y_sale_order_id" string="Sale Order" />
			</field>
		</field>
	</record>

	
</odoo>
