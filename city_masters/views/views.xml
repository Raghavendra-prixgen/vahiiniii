

<odoo>
  <data>



  <record id="view_district_form" model="ir.ui.view">
    <field name="name">res.district.form</field>
    <field name="model">res.district</field>
    <field name="arch" type="xml">
    <form string="District">
      <sheet>
        <group>
          <field name="y_name" default_focus="1" placeholder="Name" />
          <field name="y_state_id"/>
          <field name="y_country_id"/>
        </group>
      </sheet>
    </form>
    </field>
  </record>

  <record id="view_district_tree" model="ir.ui.view">
    <field name="name">res.district.tree</field>
    <field name="model">res.district</field>
    <field name="arch" type="xml">
      <list string="State">
        <field name="y_name"/>
        <field name="y_state_id" />
        <field name="y_country_id"/>
      </list>
      </field>
  </record>

  <record id="view_city_form" model="ir.ui.view">
    <field name="name">res.city.form</field>
    <field name="model">res.city</field>
    <field name="arch" type="xml">
      <form string="Taluk">
        <sheet>
          <group>
            <field name="y_name" default_focus="1" placeholder="Name" />
            <field name="y_district_id"/>
            <field name="y_state_id"/>
            <field name="y_country_id"/>
          </group>
        </sheet>
      </form>
      </field>
  </record>

  <record id="view_city_tree" model="ir.ui.view">
    <field name="name">res.district.tree</field>
    <field name="model">res.city</field>
    <field name="arch" type="xml">
    <list string="State">
      <field name="y_name"/>
      <field name="y_district_id" />
      <field name="y_state_id"/>  
      <field name="y_country_id"/>
    </list>
    </field>
  </record>





  <record id="contact_city_view" model="ir.ui.view">
    <field name="name">view_partner_form.view</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='city']" position="replace" string="Taluk">
        <field name="city" invisible="1"/>
        <field name="y_city_id" placeholder="Taluk" domain="[('y_district_id','=?',y_district_id)]"/>
        <field name="y_district_id" placeholder="District" domain="[('y_state_id','=?',state_id)]" />
      </xpath>

    
      <xpath expr="//form//notebook//field[@name='child_ids']/form//field[@name='city']" position='replace'>
                <field name="city" invisible="1"/>
                <field name="y_city_id" placeholder="Taluk" domain="[('y_district_id','=?',y_district_id)]"/>
                <field name="y_district_id" placeholder="District" domain="[('y_state_id','=?',state_id)]" />
       
      </xpath> 
    </field>
  </record>


  <record id="action_district_form" model="ir.actions.act_window">
    <field name="name">District</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.district</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_city_form" model="ir.actions.act_window">
    <field name="name">Taluk</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.city</field>
    <field name="view_mode">list,form</field>
  </record>



  <record id="crm_lead_view_form_inherit" model="ir.ui.view">
      <field name="name">lns crm view form</field>
      <field name="model">crm.lead</field>
      <field name="inherit_id" ref="crm.crm_lead_view_form"/>
      <field name="arch" type="xml">

        <xpath expr="//page[@name='lead']//field[hasclass('o_address_city')]" position="replace">
            <field name="city" invisible="1"/>
            <field name="y_city_id" placeholder="Taluk" domain="[('y_district_id','=?',y_district_id)]"/>
            <field name="y_district_id" placeholder="District" domain="[('y_state_id','=?',state_id)]" />
      </xpath>
        <xpath expr="//group[@name='lead_partner']//field[hasclass('o_address_city')]" position="replace">
            <field name="city" invisible="1"/>
            <field name="y_city_id" placeholder="Taluk" domain="[('y_district_id','=?',y_district_id)]"/>
            <field name="y_district_id" placeholder="District" domain="[('y_state_id','=?',state_id)]" />
        </xpath>

       </field>
    </record>


    <menuitem id="menu_district_form" name="District" parent="contacts.menu_localisation" action="action_district_form" sequence="4"/>
    <menuitem id="menu_city_form" name="Taluk" parent="contacts.menu_localisation" action="action_city_form" sequence="5"/> 

    


  </data>
</odoo>
