<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="view_grin_not_billed_report_list" model="ir.ui.view">
            <field name="name">grin.not.billed.report.list</field>
            <field name="model">grin.not.billed.report</field>
            <field name="arch" type="xml">
                <list string="GRN Not Billed Report" export_xlsx="false">
                    <field name="y_purchase_id"/>
                    <field name="y_partner_id"/>
                    <field name="y_bill_reference"/>
                    <field name="total_received_value" sum="Debit" widget="float" string="Debit"/>
                    <field name="total_billed_value" sum="Credit" widget="float" string="Credit"/>
                    <field name="not_billed_value" sum="Difference" widget="float" bold="True" color="#ff0000" string="Difference"/>
                    <field name="y_status" widget="badge" decoration-info="y_status== 'partially'" decoration-muted="y_status == 'un_reconciled'" decoration-success="y_status == 'reconciled'"/>
                    <field name="company_id" groups="base.group_multi_company"/>

                </list>
            </field>
        </record>

        <record id="view_grin_not_billed_report_filter" model="ir.ui.view">
            <field name="name">grin.not.billed.report.search.view</field>
            <field name="model">grin.not.billed.report</field>
            <field name="arch" type="xml">
                <search string="Search GNB">
                    <field name="y_purchase_id" string="Purchase Order"/>
                    <field name="y_partner_id"/>
                    <field name="y_bill_reference"/>
                    <group expand="0" string="Group By">
                      <filter name="y_status" string="Status" domain="[]" context="{'group_by':'y_status'}"/>
                    </group>
               </search>
            </field>
        </record>

        <record id="action_grin_not_billed_report" model="ir.actions.server">
            <field name="name">GRIR Register(New)</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_grin_not_billed_report"/>
            <field name="binding_model_id" eval="False"/>
            <field name="state">code</field>
            <field name="code">action = model.button_view_report()</field>
        </record>


        <menuitem id="menu_grin_not_billed_report"
                  name="GRIR Register(New)"
                  parent="account_additional_reports.menu_additional_reports"
                  action="action_grin_not_billed_report"
                  sequence="20"/>


    </data>
</odoo>