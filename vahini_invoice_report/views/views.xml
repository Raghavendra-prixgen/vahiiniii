<odoo>
    <data>
        <record model="ir.ui.view" id="view_form_sale_order_inherit">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//form//sheet//notebook/page/field[@name='order_line']//list/field[@name='product_uom'][2]" position="after">
                    <field name="y_alternate_uom" optional="show" readonly="1" force_save="1"/>
                    <field name="y_quantity_alt_uom" optional="show" readonly="1" force_save="1" />
                </xpath>
            </field> 
        </record>

        <record model="ir.ui.view" id="inherit_view_account_move_tree">
            <field name="name">inherit.view.account.move</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="paid_date" />
                </xpath>
            </field>
        </record>    

    </data>
</odoo>