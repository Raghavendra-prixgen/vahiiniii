<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="equipment_category_maintenance_integ_with_mrp" model="ir.ui.view">
        <field name="name">Equipment Category</field>
        <field name="model">maintenance.equipment.category</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_alias']" position="before">
                <group>
                    <group>
                        <field name='sequence' options="{'no_create': True, 'no_create_edit':True}"/>
                        <field name="working_schedule_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="equipment_maintenance_integ_with_mrp" model="ir.ui.view">
        <field name="name">Maintenance Equipment</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr='//form/sheet' position='before'>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="after">
                <field name="image_equ" widget="image" class="oe_avatar" options="{'preview_image': 'image_equ'}"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]//label[@for='name']" position="before">
                <h3>
                    <field name="equipment_number" readonly="1"/>
                </h3>
            </xpath>
            <field name="location" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="location" position="after">
                <field name="location_id" string="Stored Location"
                       options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="sub_category_1" domain="[('parent_equipment_categ','=',category_id)]"
                       options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="sub_category_2" domain="[('parent_sub_equipment_categ_1','=',sub_category_1)]"
                       options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="sub_category_3" domain="[('parent_sub_equipment_categ_2','=',sub_category_2)]"
                       options="{'no_create': True, 'no_create_edit':True}"/>
            </field>
            <field name="category_id" position="before">
                <field name="is_seq" invisible="1"/>
                <!-- <field name="equipment_number" readonly="is_seq" force_save="1" /> -->
            </field>
            <!-- <field name="category_id" position="after">
              <field name="sub_category_1" domain="[('parent_equipment_categ','=',category_id)]" options="{'no_create': True, 'no_create_edit':True}"/>
              <field name="sub_category_2" domain="[('parent_sub_equipment_categ_1','=',sub_category_1)]" options="{'no_create': True, 'no_create_edit':True}"/>
              <field name="sub_category_3" domain="[('parent_sub_equipment_categ_2','=',sub_category_2)]" options="{'no_create': True, 'no_create_edit':True}"/>
            </field> -->
            <field name="serial_no" position="after">
                <field name="dimension"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page name="Schedule">
                    <group>
                        <group>
                            <field name="state_date"/>
                            <field name="end_date"/>
                            <field name="frequency" required="1"/>
                            <field name="working_schedule_id"/>
                        </group>
                        <group>
                            <!-- <field name="is_every"/> -->
                            <!-- <field name="manual_input_date"/> -->
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

