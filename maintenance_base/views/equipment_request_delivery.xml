<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="equipment_request_delivery_view_inherited_tree" model="ir.ui.view">
        <field name="name">equipment.request.delivery.view.inherited.tree</field>
        <field name="model">equipment.request.delivery</field>
        <field name="arch" type="xml">
            <list string="Equipment List" create="1">
                <field name="name"/>
                <field name="company_id"/>
                <field name="scheduled_date"/>
                <field name="state" decoration-success="state == 'done'" decoration-info="state == 'draft'"
                       widget="badge"/>
            </list>
        </field>
    </record>
    <record id="equipment_request_delivery_view_inherited_form" model="ir.ui.view">
        <field name="name">equipment.request.delivery.view.form</field>
        <field name="model">equipment.request.delivery</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <header>
                    <button string="Confirm" name="validate_delivery_to_receipt" type="object"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button" name="receipt_equipment"
                                icon="fa-truck" string="Receipt" invisible="state == 'draft'"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Request"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_shipping_id" readonly="state == 'done'" required="1"/>
                            <field name="company_id" required="1"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                   readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="origin" readonly="1" invisible="1"/>
                            <field name="scheduled_date" readonly="state == 'done'" required="1"/>
                            <field name="deadline" readonly="state == 'done'" required="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Lines">
                            <field name="equipment_request_line_ids" widget="product_label_section_and_note_field_o2m"
                                   readonly="state == 'done'">

                                <list editable="bottom">
                                    <control>

                                        <create name="add_product_control" string="Add a line"/>
                                        <create name="add_section_control" string="Add a section"
                                                context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note"
                                                context="{'default_display_type': 'line_note'}"/>

                                    </control>

                                    <field name="sequence" widget="handle"/>
                                    <!-- We do not display the type because we don't want the user to be bothered with that information if he has no section or note. -->
                                    <field name="display_type" column_invisible="True"/>


                                    <field name="company_id" column_invisible="True"/>
                                    <field name="maintenance_request_id" required="not display_type"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    <field name="name"/>

                                    <field name="equipment_id" required="not display_type"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                                                                    string="Parent Equipment"/>
                                    <field name="y_allowed_child_equipment_ids" column_invisible="1"/>

                                    <field name="y_child_equipment_id"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                           domain="[('id', 'in', y_allowed_child_equipment_ids)]"/>
                                    <field name="quantity" required="not display_type"/>
                                </list>
                            </field>
                            <div>
                                <field name="y_remarks" placeholder="Remarks"/>
                            </div>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>


            </form>
        </field>
    </record>

    <record id="equipment_request_delivery_action" model="ir.actions.act_window">
        <field name="name">Maintenance Request Delivery</field>
        <field name="res_model">equipment.request.delivery</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="equipment_request_delivery_menu" name="Maintenance Request Delivery"
              action="equipment_request_delivery_action"
              parent="maintenance.menu_equipment_form" sequence="3"/>

</odoo>