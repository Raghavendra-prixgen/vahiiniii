<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="maintenance_equipment_seq_id" model="ir.sequence">
            <field name="name">Equipment Category</field>
            <field name="code">maintenance.equipment.category</field>
            <field name="prefix">EQ</field>
            <field name="padding">5</field>
        </record>

        <record id="maintenance_equipment_id" model="ir.sequence">
            <field name="name">Maintenance Equipment</field>
            <field name="code">maintenance.equipment</field>
            <field name="prefix">MEQ</field>
            <field name="padding">5</field>
        </record>

        <record id="jobwork_challan_number_sequence" model="ir.sequence">
            <field name="name">Jobwork Challan Number</field>
            <field name="code">jobwork.challan.number</field>
            <field name="prefix">JWC/</field>
            <field name="padding">5</field>
        </record>

        <record id="sequence_equipment_request" model="ir.sequence">
            <field name="name">Maintenance Request</field>
            <field name="code">equipment.request</field>
            <field name="prefix">MR/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_equipment_request_delivery" model="ir.sequence">
            <field name="name">Maintenance Request Sequence</field>
            <field name="code">equipment.request.delivery</field>
            <field name="prefix">MR-OUT/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_equipment_request_receipt" model="ir.sequence">
            <field name="name">Maintenance Request Sequence</field>
            <field name="code">equipment.request.receipt</field>
            <field name="prefix">MR-IN/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_equipment_allocation" model="ir.sequence">
            <field name="name">Equipment Allocation</field>
            <field name="code">equipment.allocation</field>
            <field name="prefix">EA/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>