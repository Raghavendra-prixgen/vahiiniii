<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_eq_backorder_confirmation1" model="ir.ui.view">
        <field name="name">eq.backorder.confirmation</field>
        <field name="model">eq.backorder.confirmation</field>
        <field name="arch" type="xml">
            <form string="Backorder creation">
                <group>
                    <group>
                        <div colspan="2"><p name="explanation-text">
                            You have processed less Equipments than the initial demand.
                        </p></div>
                    </group>
                    <group>
                        <div colspan="2" class="text-muted">
                            Create a backorder if you expect to process the remaining
                            Equipments later. Do not create a backorder if you will not
                            process the remaining Equipments.
                        </div>
                    </group>
                </group>

               
                <field name="equipment_delivery_ids" string="Demo" invisible="1"/>
                <field name="equipment_receipt_ids" string="Demo1" invisible="1"/>

                <field name="show_transfers" invisible="1"/>
                <field name="equipment_backorder_confirmation_line_ids" nolabel="1" invisible="show_transfers == False">
                    <list create="0" delete="0" editable="top">
                        <field name="equipment_delivery_id"/>
                        <field name="equipment_receipt_id"/>
                        <field name="to_backorder" widget="boolean_toggle"/>
                        
                    </list>
                </field>
                <footer>
                    <button name="process" string="Create Backorder" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button name="process_cancel_backorder" string="No Backorder" type="object" class="btn-primary" invisible="show_transfers != False" data-hotkey="w"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
