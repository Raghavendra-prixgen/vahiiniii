                    <field name="y_remaining_qty" readonly="1"/>
                </xpath>           
            </field>
        </record>
 -->

        <record id="view_product_landed_cost_form_new" model="ir.ui.view">
            <field name="name">product.template.landed.cost.form.new</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock_landed_costs.view_product_landed_cost_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='bill']/field[@name='landed_cost_ok']" position="after">
                    <field name="y_automated_landed_cost"  invisible="not landed_cost_ok"/>
                </xpath>                   
            </field>
        </record>
        
	</data>
</odoo>
