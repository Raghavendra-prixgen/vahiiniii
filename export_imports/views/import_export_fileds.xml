        <record id="action_port_delivery_master" model="ir.actions.act_window">
            <field name="name">Port Master</field>
            <field name="res_model">l10n_in.port.code</field>
            <field name="view_mode">list</field>
        </record>

        <record model="ir.ui.view" id="_l10n_in_port_code_tree_view_">
            <field name="name">Port Master</field>
            <field name="model">l10n_in.port.code</field>
            <field name="inherit_id" ref="l10n_in.l10n_in_port_code_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="editable">bottom</attribute>
                </xpath>
                <xpath expr="//field[@name='state_id']" position="attributes">
                    <attribute name="domain">[('country_id','=',y_country_id)]</attribute>
                </xpath>
                <field name="state_id" position="before">
                    <field name="y_city"/>
                </field>
                <field name="state_id" position="after">
                    <field name="y_country_id"/>
                    <field name="y_pre_carriage" required="1"/>
                </field>
            </field>
        </record>

