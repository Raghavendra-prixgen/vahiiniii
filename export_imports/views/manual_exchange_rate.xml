<odoo>

    <record id="view_account_form_move_inheritss" model="ir.ui.view">
      <field name="name">account.move.lines.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <field name="partner_bank_id" position="after">
          <field name="y_is_same_currency" invisible="1"/>

          <label for="y_manual_rate"  invisible="not y_is_same_currency"/>
                   
              <div name="y_manual_rate_div" class="d-flex" invisible="not y_is_same_currency" >
                  <field name="y_manual_rate" force_save="1" readonly="state != 'draft'" invisible="not y_is_same_currency"/>

                 
                  <div name="update_exchange_rate_div" groups="base.group_multi_currency" invisible="not y_is_same_currency" class="w-100" style="white-space: pre;">
                      <button name="update_exchange_rate" type="object" icon="fa-refresh" invisible="state == 'posted' or not y_is_same_currency"/>  
                      <div class="break"/>
                     
                  </div>
              </div>

        </field>
       
      </field>
    </record>

    <record id="view_account_form_payment_inheritss" model="ir.ui.view">
      <field name="name">account.payment.lines.inherit</field>
      <field name="model">account.payment</field>
      <field name="inherit_id" ref="account.view_account_payment_form"/>
      <field name="arch" type="xml">
        <field name="date" position="after">
          <field name="y_is_same_currency" invisible="1"/>

          <field name="y_manual_rate" readonly="state != 'draft'"  invisible="not y_is_same_currency"/>
        </field>
        
      </field>
    </record>

    <record id="view_account_form_manual_payment_inheritss" model="ir.ui.view">
      <field name="name">account.manual.payment.lines.inherit</field>
      <field name="model">account.payment.register</field>
      <field name="inherit_id" ref="account.view_account_payment_register_form"/>
      <field name="arch" type="xml">
        <field name="communication" position="after">
          <field name="y_is_same_currency" invisible="1"/>

          <field name="y_manual_rate"  invisible="not y_is_same_currency"/>
        </field>
        
      </field>
    </record>


    <record id="view_sale_order_exchange_rate_form_move_inherits" model="ir.ui.view">
      <field name="name">sale.order.lines.inherit</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">

        <field name="date_order" position="after">
          <field name="y_is_same_currency" invisible="1"/>

          <label for="y_manual_rate"  invisible="not y_is_same_currency"/>
                   
              <div name="y_manual_rate_div" class="d-flex" invisible="not y_is_same_currency" >
                  <field name="y_manual_rate" force_save="1" readonly="state != 'draft'" invisible="not y_is_same_currency"/>

                  <div name="update_exchange_rate_div" groups="base.group_multi_currency" invisible="not y_is_same_currency" class="w-100" style="white-space: pre;">
                      <button name="update_exchange_rate" type="object" icon="fa-refresh" invisible="state == 'sale' or not y_is_same_currency"/>  
                      <div class="break"/>
                     
                  </div>
              </div>

        </field>
       
      </field>
    </record>

    <record id="view_purchase_order_exchange_rate_form_move_inherits" model="ir.ui.view">
      <field name="name">purchase.order.lines.inherit</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">

        <field name="date_order" position="before">
          <field name="y_is_same_currency" invisible="1"/>

          <label for="y_manual_rate"  invisible="not y_is_same_currency"/>
                   
              <div name="y_manual_rate_div" class="d-flex" invisible="not y_is_same_currency" >
                  <field name="y_manual_rate" force_save="1" readonly="state != 'draft'" invisible="not y_is_same_currency"/>

                  <div name="update_exchange_rate_div" groups="base.group_multi_currency" invisible="not y_is_same_currency" class="w-100" style="white-space: pre;">
                      <button name="update_exchange_rate" type="object" icon="fa-refresh" invisible="state in ('purchase','done') or not y_is_same_currency"/>  
                      <div class="break"/>

                     
                  </div>
              </div>

        </field>
       
      </field>
    </record>

    



   
</odoo>