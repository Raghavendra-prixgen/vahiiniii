<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<data>
	<record id="discount_tree_inherit_view_tot_weight" model="ir.ui.view">
			<field name="name">sale.order.form</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form"/>
			<field name="arch" type="xml">
				
				<xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
					<field name="y_product_total_weight" readonly="1" optional='show'  force_save="1" sum="y_product_total_weight"/>				
				</xpath>
				
			</field>
	</record>

	</data>
</odoo>
