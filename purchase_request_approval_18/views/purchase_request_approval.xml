<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================# Purchase Approval Configuration #======================= -->

    <record id="purchase_request_teype_view_tree_is_approval_required" model="ir.ui.view">
        <field name="name">request.type.type.view.list.inherited</field>
        <field name="model">request.type</field>
        <field name="inherit_id" ref="purchase_base_18.request_type_view_tree_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="y_is_approval_required" widget="boolean_toggle" string="Approval Required"/>
            </field>
            <field name="approver_ids" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="view_purchase_request_approval_form" model="ir.ui.view">
        <field name="name">purchase.request.approval.form</field>
        <field name="model">purchase.request.approval</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Approval">
                <sheet>
                    <group>
                        <group>
                            <field name="y_company_id" invisible="1"/>
                            <field name="y_parent_company_id" invisible="1"/>
                            <field name="y_request_type_id" required='1' options="{'no_create': True, 'no_open': True}" domain="['|','|','|',('company_id', '=', False),('company_id', 'child_of', y_company_id),('company_id', '=', y_company_id),('company_id', '=', y_parent_company_id)]"/>
                            <field name="y_name" />
                            <!-- <field name="y_procurement_group_id" options="{'no_create': True, 'no_create_edit':True,'no_open':True}"/> -->
                        </group>
                        <group>
                            <field name="y_company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approvals" name="lvlandamount">
                            <field name="y_lvl_amt_approval_lines" widget="section_and_note_one2many" >
                                <list string="Lvl and Amt Approval Lines" editable="bottom">
                                    <field name='y_approval_level' required="1"/>
                                    <field name='y_approval_amount_from' column_invisible="True" />
                                    <field name='y_approval_amount_to' column_invisible="True" />
                                    <field name='y_lvl1_user_id' options="{'no_create': True, 'no_open': True}" required ="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval','4thlvlapproval','5thlvlapproval')"/>
                                    <field name='y_lvl2_user_id'   options="{'no_create': True, 'no_open': True}" readonly ="y_approval_level == '1stlvlapproval'" required="y_approval_level in ('3rdlvlapproval','2ndlvlapproval','4thlvlapproval','5thlvlapproval')" force_save="1"/>
                                    <field name='y_lvl3_user_id'   options="{'no_create': True, 'no_open': True}" readonly ="y_approval_level in ('1stlvlapproval','2ndlvlapproval')" required ="y_approval_level in ('3rdlvlapproval','4thlvlapproval','5thlvlapproval')" force_save="1"/>
                                    <field name='y_lvl4_user_id'   options="{'no_create': True, 'no_open': True}" readonly ="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval')" required ="y_approval_level in ('4thlvlapproval','5thlvlapproval')" force_save="1"/>
                                    <field name='y_lvl5_user_id'   options="{'no_create': True, 'no_open': True}" readonly ="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval','4thlvlapproval')" required="y_approval_level == '5thlvlapproval'" force_save="1"/>
                                                                            
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="search_view_purchase_request_approval">
        <field name="name">purchase.request.approval.search</field>
        <field name="model">purchase.request.approval</field>
        <field name="arch" type="xml">
            <search>
              <field name="y_request_type_id"/>
              <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_purchase_request_approval_form_tree" model="ir.ui.view">
        <field name="name">purchase.request.approval.list</field>
        <field name="model">purchase.request.approval</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <list string="Purchase Request Approval" >
                <field name="y_request_type_id"/>
                <field name="y_company_id"/>
            </list>
        </field>
    </record>

    <record model="ir.rule" id="purchase_request_approval_record_restricted_company_rule">
        <field name="name">Purchase Request Approval Restricted Record: multi-company</field>
        <field name="model_id" ref="model_purchase_request_approval"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('y_company_id', '=', False), ('y_company_id', 'parent_of', company_ids)]
        </field>
    </record>

    <record id="action_purchase_request_approval" model="ir.actions.act_window">
        <field name="name">Purchase Request Approval Setting</field>
        <field name="res_model">purchase.request.approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
        id="menu_purchase_request_approval" 
        name="Approval Setting PR" 
        parent="purchase_base_18.menu_product_in_config_purchase_others"
        action="action_purchase_request_approval" sequence="150"
    />

    <!-- ===================# Purchase Approval Configuration END #======================= -->


    <!-- ===================# Purchase Approval in Purchase Order #======================= -->

    <record model="ir.ui.view" id="purchase_request_order_approval">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_base_18.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button name="confirm_approval"  type="object" class="oe_highlight" invisible="state != 'to_approve' or y_is_approval_required ==  False or state != 'to_approve'" string="Approve"/>
                <button name="confirm_approval"  type="object" class="oe_highlight" invisible="y_is_approval_required !=  False or state != 'draft'" string="Confirm"/>
                <field name="y_is_approval_required" invisible="1"/>
            </button>
            <button name="button_draft" position="attributes">
                <attribute name="invisible">state not in ('cancel','to_approve','rejected')</attribute>
            </button>
            <button name="button_approved" position="attributes">
                <attribute name="invisible">y_is_approval_required != False or state != 'to_approve'</attribute>
            </button>
            <button name="button_to_approve" position="attributes">
                <attribute name="invisible">y_is_approval_required == False or state != 'draft'</attribute>
            </button>

            <field name="line_ids" position="attributes">
                <attribute name="readonly">state in ('done','to_approve','rejected')</attribute>
            </field>
            <field name="company_id" position='after'>
                <field name="y_to_approve_states"  invisible='1'/>
                <field name="y_is_approval_required" invisible="1"/>
                <field name="y_is_approval_show" invisible="1"/>
            </field>
            <field name="approver_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <notebook position="inside">
                <page string="Approvals" invisible="y_is_approval_show == False">
                    <field name='y_purchase_request_lvl_amt_approval_line' widget="section_and_note_one2many" readonly="1">
                        <list>
                            <field name='y_approval_level'/>
                            <field name='y_lvl_user_id' widget="badge" decoration-success="1"/>
                            <button name="view_code_users" type="object" string="" icon="fa-eye" class="btn-secondary" help="View Users"/>
                            <field name="y_approved_date"/>
                            <field name="y_approved_id"/>
                            <field name='y_purchase_lvl_id' column_invisible="True" string="Purchase Request lvl"/>
                            <field name="y_approval_status" widget="badge" decoration-success="y_approval_status == 'approved'" decoration-primary="y_approval_status == 'approval_pending'" decoration-info="y_approval_status == 'rejected'"/>
                            <field name="y_is_approval_completed" string="Approval Completed" column_invisible="True"/>
                            <field name="y_remarks"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    
    <record id="purchase_request_tree_view_new" model="ir.ui.view">
        <field name="name">purchase.request.list.view</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_base_18.view_purchase_request_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="y_to_approve_states" widget="badge"/>
            </field>
        </field>
    </record>


</odoo>
