<odoo>
    <record model="ir.ui.view" id="purchase_order_line_tree_inherit">
        <field name="name">purchase_order_line.list.inherit </field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom']" position="after">
                <field name="y_is_short_close" />

            </xpath>
        </field>
    </record>

    <record id="view_purchase_short_close_wizard_form" model="ir.ui.view">
        <field name="name">purchase.short.close.wizard.form</field>
        <field name="model">purchase.short.close.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <group>
                    <group>
                        <field name="y_short_close_reason_id" invisible="1" string="Short Close Reason"  options="{'no_create': True, 'no_create_edit':True,'no_open': True}"/>
                    </group>
                </group>
                <!-- <label for="y_sc_po_lines_ids"/> -->
                <field name="y_purchase_id" invisible="1" />
                <field name="y_sc_po_lines_ids" string="Short Close Purchase Order Lines" domain="[('order_id','=',y_purchase_id),('y_is_short_close','=',False)]">
                    <list editable='bottom' >
                        <field name="order_id" readonly="1" />
                        <field name="partner_id" readonly="1" />
                        <field name="product_id" readonly="1" />
                        <field name="product_qty" readonly="1" />
                        <field name="qty_received" readonly="1" />
                        <field name="y_is_short_close" />
                        <field name="y_short_close_reason_id" required="1" attrs="{'required':[('y_is_short_close','=',True)]}"/>
                        <field name="date_planned" readonly="1" />
                        <field name="price_unit" readonly="1" />
                        <field name="price_subtotal" readonly="1" />
                        <field name="product_uom_qty" readonly="1" />

                    </list>
                </field>
                <footer>
                    <group>
                        <button class="btn btn-primary" type="object" name="button_action_short_close"
                            string="Confirm" />
                    </group>
                </footer>
            </form>
        </field>
    </record>

    <record id="purchase_short_close_reason_tree_view" model="ir.ui.view">
        <field name="name">purchase.short.close.reason.view.list</field>
        <field name="model">purchase.short.close.reason</field>
        <field name="arch" type="xml">
          <list editable="bottom" duplicate="0">
            <field name="y_name"/>
          </list>
        </field>
      </record>
  
  
       <record id="purchase_short_close_reason_action" model="ir.actions.act_window">
        <field name="name">Short Close Reasons For PO</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.short.close.reason</field>
        <field name="view_mode">list,form</field>
      </record>
  
     <menuitem id="menu_config_purchase_short_close_reason" name="Short Close Reasons For PO"
      parent="purchase_base_18.menu_product_in_config_purchase_others" 
      action="purchase_short_close_reason_action" sequence="114"/>
  
      </odoo>