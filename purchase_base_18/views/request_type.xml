<odoo>
    <data>
        
        <record id="request_type_view_tree_view" model="ir.ui.view">
          <field name="name">request.type.type.view.list</field>
          <field name="model">request.type</field>
          <field name="arch" type="xml">
            <list editable="bottom" duplicate="0">
              <field name="name" required="1"/>
              <field name="approver_ids" widget="many2many_tags" required="1"/>
              <field name="sequence_id" required="True" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}"/>
              <field name="company_id" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}" groups="base.group_multi_company"/>
            </list>
          </field>
        </record>

        <record model="ir.rule" id="request_type_record_restricted_company_rule">
            <field name="name">Request Type Restricted Record: multi-company</field>
            <field name="model_id" ref="model_request_type"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]
            </field>
        </record>


         <record id="purchase_request_type_action" model="ir.actions.act_window">
          <field name="name">Document Type PR</field>
          <field name="type">ir.actions.act_window</field>
          <field name="res_model">request.type</field>
          <field name="view_mode">list,form</field>
        </record>

       
        <menuitem id="purchase_request_type_menu_act" name="Document Type PR" 
        parent="purchase_base_18.menu_product_in_config_purchase_others" action="purchase_request_type_action" sequence="112"/>
    
    </data>
</odoo>
