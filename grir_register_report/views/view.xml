<odoo>
  
  <record id="get_values_grir_register_report_action" model="ir.actions.server">
      <field name="name">GR not Invoiced Report</field>
      <field name="type">ir.actions.server</field>
      <field name="model_id" ref="model_grir_register_report"/>
      <field name="binding_model_id" eval="False"/>
      <field name="state">code</field>
      <field name="code">action = model.grir_register_report_query()</field>
  </record>

  <record id="inventory_grir_register_report_form_view" model="ir.ui.view">
    <field name="name">inventory.grir.register.report.form.view</field>
    <field name="model">grir.register.report</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="y_purchase_id" string="Purchase Order" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="y_picking_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </group>
            <group>
              <field name="y_credit" sum="y_credit"/>
              <field name="y_debit" sum="y_debit"/>
              <field name="y_diffrence_value" sum="y_diffrence_value"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>


  <record id="inventory_grir_register_report_tree_view" model="ir.ui.view">
    <field name="name">inventory.grir.register.report.list.view</field>
    <field name="model">grir.register.report</field>
    <field name="arch" type="xml">
      <list edit="1" delete="0" import="0" sample="1">
        <field name="id" string="Sl No"/>
        <field name="y_purchase_id" string="Purchase Order"/>
        <field name="y_partner_id"/>
        <field name="y_picking_id"/>
        <field name="y_date_done" string="Date"/>
        <field name="y_bill_journal_entry_reference"/>
        <field name="y_debit" sum="y_debit" string="Debit"/>
        <field name="y_credit" sum="y_credit" string="Credit"/>
        <field name="y_diffrence_value" sum="y_diffrence_value"/>
        <field name="y_status" widget="badge" decoration-info="y_status== 'partially'" decoration-muted="y_status == 'un_reconciled'" decoration-success="y_status == 'reconciled'"/>
      </list>
    </field>
  </record>

  <record id="view_grir_register_report_filter" model="ir.ui.view">
    <field name="name">grir.register.report.search.view</field>
    <field name="model">grir.register.report</field>
    <field name="arch" type="xml">
        <search string="Search Delivery">
            <field name="y_purchase_id" string="Purchase Order"/>
            <field name="y_partner_id"/>
            <field name="y_picking_id"/>
            <field name="y_bill_journal_entry_reference"/>
            <group expand="0" string="Group By">
              <filter name="y_status" string="Status" domain="[]" context="{'group_by':'y_status'}"/>
            </group>
       </search>
    </field>
  </record>

  <menuitem id="inventory_grir_register_report_menu" name="GRIR Register" parent="account_additional_reports.menu_additional_reports" 
  sequence="1"
  action="get_values_grir_register_report_action"/>

</odoo>
