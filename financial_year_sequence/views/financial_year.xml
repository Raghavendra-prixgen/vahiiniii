<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="sequence_view" model="ir.ui.view">
            <field name="name">Sale Orde Form</field>
            <field name="model">ir.sequence</field>
            <field name="inherit_id" ref="base.sequence_view"/>
            <field name="arch" type="xml">  
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='sequence']/group[2]/group[1]/span[2]" position="after">
                    <span colspan="2">Financial Year with Century: %%(financial_year)s</span>
                    <span colspan="2">Financial Year without Century: %%(f_y)s</span>
                </xpath>
            </field>
        </record>

</odoo>