<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<template id="portal_my_home_quotation_request" name="Portal My Home Quotation Request" inherit_id="sale.portal_my_home_sale" priority="25">
		<xpath expr="//div[@id='portal_client_category']/t[@t-call='portal.portal_docs_entry'][1]" position="before">
			<t t-call="portal.portal_docs_entry">
				<t t-set="icon" t-value="'/customer_portal_standard/static/description/img/request_icon.png'"/>
				<t t-set="title">Request Your Order</t>
				<t t-set="url" t-value="'/quotes/new/view'"/>
				<t t-set="text">Request/Create your order</t>
				<t t-set="placeholder_count" t-value="'order_count'"/>
				<t t-set="config_card" t-value="True"/>
			</t>
		</xpath>
	</template>

	<template id="sale.portal_my_quotations" name="My Quotations">
		<t t-call="portal.portal_layout">
			<t t-set="breadcrumbs_searchbar" t-value="True" />
			<t t-call="portal.portal_searchbar">
				<t t-set="title">
					Quotations
				</t>
				<t t-if="quot_create">
					<div class="form-inline">
						<a href="/quotes/new/view" class="btn btn-success" style="margin-left:15px;">
							<i class="fa fa-solid fa-plus"></i>
							 Create Quotation
						</a>
					</div>
				</t>
			</t>
			<t t-if="not quotations">
				<p>
					There are currently no quotations for your account.
				</p>
			</t>
			<t t-if="quotations" t-call="portal.portal_table">
				<thead>
					<tr class="active">
						<th>
							Quotation #
						</th>
						<th class="text-right">
							Quotation Date
						</th>
						<th class="text-right">
							Valid Until
						</th>
						<th class="text-center">
							Status
						</th>
						<th class="text-right">
							Total
						</th>

					</tr>
				</thead>
				<t t-foreach="quotations" t-as="quotation">
					<tr>
						<td>
							<a t-att-href="quotation.get_portal_url()">
								<t t-esc="quotation.name" />
							</a>
						</td>
						<td class="text-right">
							<span t-field="quotation.date_order" />
						</td>
						<td class="text-right">
							<span t-field="quotation.validity_date" />
						</td>
						<td class="text-center">
							<span t-if="quotation.state == 'draft'" class="badge rounded-pill text-bg-primary">
								Draft
							</span>
							<span t-if="quotation.state == 'sent'" class="badge rounded-pill text-bg-info">
								Quotation Sent
							</span>
							<span t-if="quotation.state == 'sale'" class="badge rounded-pill text-bg-success">
								Sales Order
							</span>
							<span t-if="quotation.state == 'cancel'" class="badge rounded-pill text-bg-danger">
								Cancelled
							</span>
						</td>
						<td class="text-right">
							<span t-field="quotation.amount_total" />
						</td>

					</tr>
				</t>
			</t>
		</t>
	</template>

	<template id="quotation_form" name="PortalQuotation">
		<t t-call="portal.portal_layout">
			<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.0.0/jquery.min.js">
			</script>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.2/jquery.modal.min.js">
			</script>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.2/jquery.modal.min.css" />
			<div id="wrap">
				<div class="container mt-1">
					<form action="" class="catalogue_div modal" id="ex2" style="display:none;">
						<div class="cat_header">
							<b>
								<h3 id="select_produts" class="mt-2" style="font-weight:400;">
									Select Products
								</h3>
							</b>
						</div>
						<div class="modal-footer d-flex flex-wrap" style="justify-content:space-around;">
							<div class="col-12 col-md-3 d-flex mb-2">
								<a href="#" class="btn btn-primary label-text-align me-2" rel="modal:close">
            						CLOSE
								</a>
								<a href="#" class="btn btn-primary label-text-align update_items" rel="modal:close">
            						UPDATE
								</a>
							</div>
							<div class="col-12 col-md-4 mb-2">
								<input type="text" id="product-search" class="form-control" placeholder="Search Products" />
							</div>
							<div class="col-12 col-md-3 d-flex align-items-center justify-content-center">
								<label for="sortOption" class="me-2 text-center">
            						Sort By
								</label>
								<select id="sortOption" class="form-select" style="width: 150px;">
									<option value="default"></option>
									<option value="name">Name</option>
									<option value="price">Price</option>
									<option value="code">Code</option>
								</select>
							</div>
						</div>

						<div class="product_block m-4">
							<!-- <t t-set="group_product_variant" t-value="request.env['ir.config_parameter'].sudo().get_param('group_product_variant', False)"/>
							<t t-if="group_product_variant">
								<t t-set="product_variants" t-value="request.env['product.product'].sudo().search([('sale_ok','=',True),('y_product_portal_boolean', '=', True)])" />
							</t>
							<t t-else="">
								<t t-set="product_variants" t-value="request.env['product.product'].sudo().search([('sale_ok','=',True),('product_tmpl_id.y_product_portal_boolean', '=', True)])" />
							</t>
 -->
							<t t-foreach="product" t-as="po">
								<div class="product-card" t-att-value="po.id">
									<div class="product-card-head">
										<div class="product-image" style="margin:auto; height: 90px;">
											<img t-attf-src="/web/image/product.product/#{po.id}/image_1920" alt="Product Image" width="75" height="75" />
										</div>
										<div class="product-details">
											<h3 class="product-title">
												<t t-esc="po.name" />
											</h3>
											<p class="product-code">
												<span class="">
													CODE :
													<t t-esc="po.default_code" />
												</span>
											</p>
											<p class="product-price">
												Unit price:
												<span class="">
													<t t-esc="po.currency_id.symbol" />
												</span>
												<t t-esc="po.lst_price" />
											</p>
											<t t-if="po.product_template_variant_value_ids">
												<div class="product-options">
													<span class="option-label">
														<t t-foreach="po.product_template_variant_value_ids" t-as="ids">
															<span class="o_badge badge rounded-pill bg-primary">
																<t t-esc="ids.display_name" />
															</span>
														</t>
													</span>
												</div>
											</t>
										</div>
									</div>
									<div class="d-flex">
										<div class="product-card-foot">
											<button class="add-button" type="button">
												Add
											</button>
										</div>
										<div class="">
											<button class="pkg-options-btn" type="button">
												<i class="fa fa-solid fa-bars">
												</i>
											</button>
										</div>
									</div>
									<!-- Package Selection Dialog -->
									<div class="pkg-select-dialog" style="display: none;">
										<div class="pkg-select-header">
											<h3 class="pkg-select-title">
												Product Packages
											</h3>
											<button class="pkg-select-close">
												×
											</button>
										</div>
										<t t-set="packages" t-value="request.env['product.packaging'].sudo().search([('product_id', '=', po.id)])" />
										<div class="pkg-select-content">
											<t t-if="packages">
												<div class="pkg-select-list">
													<t t-foreach="packages" t-as="pkg">
														<div class="pkg-select-item">
															<input type="radio" t-att-name="'pkg_option_' + str(po.id)" t-att-id="pkg.id" t-att-value="pkg.qty" t-att-data-name="pkg.name" />
															<label t-att-for="'pkg_' + str(pkg.id)">
																<t t-esc="pkg.name" />
															</label>
														</div>
													</t>
												</div>
												<div class="pkg-select-quantity">
													<label t-att-for="'pkg_count_' + str(po.id)">
													No of packages required:
													</label>
													<input type="number" t-att-id="'pkg_count_' + str(po.id)" min="1" value="1" />
												</div>
												<div class="pkg-select-total">
												Total quantity:
													<span t-att-id="'pkg_total_units_' + str(po.id)">
													0
													</span>
												units
												</div>
												<div class="pkg-select-footer">
													<button class="pkg-select-save">
														Save
													</button>
												</div>
											</t>
											<t t-else="">
												<div class="">No Packages found for this product.</div>
											</t>
										</div>
									</div>
								</div>
							</t>
						</div>
					</form>
