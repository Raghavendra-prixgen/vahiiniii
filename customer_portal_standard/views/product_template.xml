<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="product_product_view_form_inherit_portal" model="ir.ui.view">
      <field name="name">product.product.view.form.inherit</field>
      <field name="model">product.product</field>
      <field name="inherit_id" ref="product.product_normal_form_view"/>
      <field name="arch" type="xml">
        <field name="categ_id" position="after">
          <field name="y_product_portal_boolean"/>
        </field>

      </field>
    </record>

    <record id="product_template_view_form_inherit_portal" model="ir.ui.view">
      <field name="name">product.template.view.form.inherit</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_only_form_view"/>
      <field name="arch" type="xml">
        <field name="default_code" position="after">
          <field name="y_product_portal_boolean"/>
        </field>

      </field>
    </record>
     <record id="product_category_view_form_inherit_company" model="ir.ui.view">
      <field name="name">product.category.view.form.inherit.company</field>
      <field name="model">product.category</field>
      <field name="inherit_id" ref="product.product_category_form_view"/>
      <field name="arch" type="xml">
        <field name="removal_strategy_id" position="after">
          <field name="y_company_id"/>
        </field>
      </field>
    </record>
  </data>
</odoo>
