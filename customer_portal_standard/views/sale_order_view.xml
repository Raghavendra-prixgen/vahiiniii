<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_list_pre_quotation" model="ir.ui.view">
        <field name="name">sale.order.list.pre.quotation</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Pre-Quotation Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_sale_order_pre_quotation" model="ir.actions.act_window">
        <field name="name">Pre-Sale Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_order_list_pre_quotation"/>
        <field name="domain">[('state', '=', 'pre_quotation')]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_sale_order_pre_quotation" name="Pre-Quotations" parent="sale.sale_order_menu" action="action_sale_order_pre_quotation" sequence="1"/>
</odoo>
