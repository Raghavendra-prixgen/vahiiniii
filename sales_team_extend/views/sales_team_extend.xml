<odoo>

    <record id="res_users_form_view_is_sale_person" model="ir.ui.view">
        <field name="name">res.users.list.view.salesperson</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[hasclass('oe_title')]/group/field[@name='partner_id']" position="after">                
                <field name="is_salesperson" widget="boolean_toggle"  />
            </xpath>
        </field>
    </record>


    <record id="sf_crm_team_form_custom_inherit" model="ir.ui.view">
        <field name="name">sf crm team form custom inherit</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page/field[@name='member_ids']" position="attributes">
                 <attribute name="domain">[]</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                 <attribute name="domain">[('is_salesperson','=',True)]</attribute>
            </xpath>

           
        </field>
    </record>

    <record id="crm_form_custom_inherit" model="ir.ui.view">
        <field name="name">crm form custom inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="attributes">
                 <attribute name="domain">[('is_salesperson','=',True)]</attribute>
            </xpath>
        </field>
    </record>

     <record id="crm_opportunity_form_custom_inherit" model="ir.ui.view">
        <field name="name">crm opportunity form custom inherit</field>
        <field name="model">crm.lead2opportunity.partner</field>
        <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="attributes">
                 <attribute name="domain">[('is_salesperson','=',True)]</attribute>
            </xpath>
        </field>
    </record>

     <record id="contact_form_custom_inherit" model="ir.ui.view">
        <field name="name">contact form custom inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="domain">[('is_salesperson','=',True)]</attribute>
              </xpath>
            
        </field>
    </record>

    <record id="view_partner_property_form_purchase" model="ir.ui.view">
            <field name="name">res.partner.purchase.property.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="purchase.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='buyer_id']" position="attributes">
                <attribute name="domain">[('is_salesperson','=',True)]</attribute>
              </xpath>
                
            </field>
    </record>


    

     <record id="invoice_form_custom_inherit" model="ir.ui.view">
        <field name="name">Invoice form custom inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                 <attribute name="domain">[('is_salesperson','=',True)]</attribute>
            </xpath>
        </field>
    </record>

    
         <record id="sale_order_sales_team_ids" model="ir.ui.view">
            <field name="name">Sale Orde Form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="attributes">
                        <attribute name="domain">[('is_salesperson','=',True)]</attribute>
                </xpath>
            </field>
        </record>

</odoo>
