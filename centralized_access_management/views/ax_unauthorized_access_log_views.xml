<odoo>
    <record id="action_unauthorized_access_log" model="ir.actions.act_window">
        <field name="name">Unauthorized Access Logs</field>
        <field name="res_model">unauthorized.access.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No unauthorized access logs found.
            </p>
        </field>
    </record>

    <menuitem id="menu_unauthorized_access_log_root" 
              name="Unauthorized Access Logs"
              parent="base.menu_administration" 
              action="action_unauthorized_access_log" 
              groups="centralized_access_management.group_access_user_cam"
              sequence="10" />

    <record id="view_unauthorized_access_log_tree" model="ir.ui.view">
        <field name="name">unauthorized.access.log.tree</field>
        <field name="model">unauthorized.access.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="attempt_date"/>
            </list>
        </field>
    </record>

    <record id="view_unauthorized_access_log_form" model="ir.ui.view">
        <field name="name">unauthorized.access.log.form</field>
        <field name="model">unauthorized.access.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="ip_address"/>
                        <field name="attempt_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_unauthorized_access_log_search" model="ir.ui.view">
        <field name="name">unauthorized.access.log.search</field>
        <field name="model">unauthorized.access.log</field>
        <field name="arch" type="xml">
            <search string="Unauthorized Access Logs">
                <field name="user_id" string="User" filter_domain="[('user_id', '!=', False)]"/>
                <field name="ip_address" string="IP Address" filter_domain="[('ip_address', '!=', False)]"/>
                <field name="attempt_date" string="Attempt Date"/>

                <filter name="filter_by_user" string="User" domain="[('user_id', '!=', False)]"/>
                <filter name="filter_by_ip" string="IP Address" domain="[('ip_address', '!=', False)]"/>
                <filter name="filter_by_date" string="Date" domain="[('attempt_date', '!=', False)]"/>

                <group expand="0" string="Group By...">
                    <filter name="group_by_user" string="User" domain="[]" context="{'group_by':'user_id'}"/>
                    <filter name="group_by_ip" string="IP Address" domain="[]" context="{'group_by':'ip_address'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>




