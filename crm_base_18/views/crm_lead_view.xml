                <page name="extra" position="after">
                    <page name="cust_lead_product_page" string="Product">
                    <field name="y_crm_product_line_ids">
                        <list editable="bottom">
                        <field name="y_cust_product_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        <field name="y_cust_qty"/>
                        <field name="y_cust_price" widget='monetary' optional="hide"/>
                        <field name="y_cust_subtotal" sum="True" widget='monetary' optional="show"/>
                        <field name="y_company_currency" invisible="1"/>
                        <field name="y_available_quantity"/>
                        <button class="oe_highlight" name="refreshtochange" type="object" string="Refresh"/>
                        </list>
                    </field>
                    </page>
                </page>
                
            </field>
        </record>
       

        <record id="sale_order_sequence_name_view" model="ir.ui.view">
            <field name="name">sale_order_sequence_gen</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sale_info']" position="inside">
                    <field name="y_lead_no" readonly="1"/> 
                </xpath>
                <!-- <xpath expr="//page/group/group[@name='sales_person']" position="inside">
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" readonly='1'/>
                </xpath> -->
            </field>
        </record>

        <record id="crm_case_form_view_oppor2" model="ir.ui.view">
            <field name="name">crm.lead.oppor.inherited.crm2</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_sale_quotations_new']" position="replace">
                    <button string="New Quotation" name="action_sale_quotations_new" type="object" class="oe_highlight" 
                        invisible="type == 'lead' or probability == 0 and not active"

                    context="{'search_default_partner_id': partner_id,
                                  'default_partner_id': partner_id,
                                  'default_team_id': team_id,
                                  'default_campaign_id': campaign_id,
                                  'default_medium_id': medium_id,
                                  'default_origin': name,
                                  'default_source_id': source_id,
                                  'default_tag_ids': tag_ids}"/>
                </xpath>
            </field>
    </record>

