                    <div>
                        <h2>
                        <label for="y_sequence_name" string="Lead No."/>
                        <field name="y_sequence_name" nolabel="1"/>
                    </h2>
                    </div>
                </xpath>
                <!-- added xpath for copying all below fields before notebook by s -->
