                <xpath expr="//field[@name='partner_name']" position="replace">
                    <label for="partner_name" string="Customer Name"/>
                    <div class="o_row">
                        <field name="partner_name"/>
                        <field name="y_customer_title" placeholder="Title" domain="[]" options="{&quot;no_open&quot;: True}"/>
                    </div>
                </xpath>

                <!-- <field name="tag_ids" position="before">
                <field name="y_expected_date"/>
                </field>  -->

                <!-- <field name="date_deadline" position="attributes">
                <attribute name="invisible">1</attribute>
                </field> -->
                
                <field name="user_id" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
        
                <field name="tag_ids" position="after">
                    <field name="user_id"   domain="[('id','in',y_cust_user_ids)]" on_change="1" can_create="true" can_write="true" modifiers="{}"/>
                    <field name="team_id" invisible="type == 'lead'"/>
                    
                    <!-- <field name="y_coordinator_id" domain="[('id','in',y_cust_user_ids)]" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/> -->
                    <field name="y_cust_user_ids" invisible='1'/>
                    <!-- <field name="y_cust_type_of_sale"/> -->
                </field>
                
                <!--  <page name="extra" position="after">
                    <page name="cust_lead_product_page" string="Product">
