    <record id="sale_order_view_search_crm_sequence1" model="ir.ui.view">
        <field name="name">sale.order.search.inherit</field>
        <field name="model">sale.order</field>

        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <field name="y_lead_no" string="Lead No"/>
                <separator/>
                <filter string="Lead No" name="y_lead_no" domain="[]" context="{'group_by': 'y_lead_no'}"/>
                
            </xpath>
        </field>
    </record>

   

    <record model="ir.ui.view" id="crm_case_tree_view_leads_inherit_lead">
       <field name="name">crm.lead.list.lead</field>
        <field name="model">crm.lead</field>
       <field name="type">list</field>
       <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
           <xpath expr="/list/field[@name='name']" position="before">
               <field name="y_sequence_name" />
           </xpath>
           <!-- <xpath expr="//list" position="attributes">
              <attribute name="delete">0</attribute>
          </xpath> -->
       </field>
   </record>

       


