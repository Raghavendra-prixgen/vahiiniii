         <record id="product_category_form_view_inventory_tracking" model="ir.ui.view">
          <field name="name">product_category_form_view_inventory_tracking</field>
          <field name="model">product.category</field>
          <field name="inherit_id" ref="stock.product_category_form_view_inherit"/>
          <field name="arch" type="xml">
            <field name="route_ids" position="before">
              <label for="y_is_storable" class="oe_inline"/>
              <div class="o_row w-100">
                  <field name="y_is_storable"/>
                  <field name="y_tracking" invisible="not y_is_storable" required="1"/>
              </div>
              <field name="y_lot_valuated" invisible="y_tracking == 'none'"/>

            </field>
          </field>
         </record>




         

         
