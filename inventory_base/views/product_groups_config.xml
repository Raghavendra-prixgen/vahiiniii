<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="product_group_config_tree_view" model="ir.ui.view">
          <field name="name">product.group.config.list.view</field>
          <field name="model">product.group.config</field>
          <field name="arch" type="xml">
            <list>
              <field name="y_name" string="Item Group" required="1"/>
              <field name="y_product_group_1" string="Product Group 1"/>
              <field name="y_product_group_2" string="Product Group 2"/>
              <field name="y_product_group_3" string="Product Group 3"/>
            </list>
          </field>
        </record>

        <record id="product_group_config_form_view" model="ir.ui.view">
          <field name="name">product.group.config.form</field>
          <field name="model">product.group.config</field>
          <field name="arch" type="xml">
            <form string="Product Classification">
              <header>
                  <button name="action_locked" type="object" string="Lock" invisible="y_state in ['locked']" data-hotkey="l" groups="inventory_base.product_group_lock_unlock_access"/>
                  <button name="action_unlock" type="object" string="Unlock" invisible="y_state in ['edit']" data-hotkey="l" groups="inventory_base.product_group_lock_unlock_access"/>
                  <field name="y_state" widget="statusbar" statusbar_visible="edit,locked" readonly="1"/>
              </header>
              <sheet>
                <div name="options">
                    <span class="d-inline-block">
                      <label for="y_name" string="Item Group" />
                      <field name="y_name" string="Item Group" required="1" style="width:232px;padding-left:43px;padding-right:20px;" readonly="y_state in ['locked']"/>
                      <label for="y_is_item_group_required" string="Required" />
                      <field name="y_is_item_group_required" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                    <span class="d-inline-block">
                      <label for="y_is_item_group_invisible" string="Active"/>
                      <field name="y_is_item_group_invisible" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                </div>
                
                <div name="options">
                    <span class="d-inline-block">
                      <label for="y_product_group_1" string="Product Group 1"/>
                      <field name="y_product_group_1" string="Product Group 1" required="1" readonly="y_state in ['locked']" style="width:199px;padding-left:10px;"/>
                      <label for="y_is_product_group_1_required" string="Required"/>
                      <field name="y_is_product_group_1_required" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                    <span class="d-inline-block">
                      <label for="y_is_product_group_1_invisible" string="Active"/>
                      <field name="y_is_product_group_1_invisible" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                </div>
                
                <div name="options">
                    <span class="d-inline-block">
                      <label for="y_product_group_2" string="Product Group 2"/>
                      <field name="y_product_group_2" string="Product Group 2" required="1" readonly="y_state in ['locked']" style="width:199px;padding-left:10px;"/>
                      <label for="y_is_product_group_2_required" string="Required"/>
                      <field name="y_is_product_group_2_required" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                    <span class="d-inline-block">
                      <label for="y_is_product_group_2_invisible" string="Active"/>
                      <field name="y_is_product_group_2_invisible" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                </div>

                <div name="options">
                    <span class="d-inline-block">
                      <label for="y_product_group_3" string="Product Group 3"/>
                      <field name="y_product_group_3" string="Product Group 3" required="1" readonly="y_state in ['locked']" style="width:199px;padding-left:10px;"/>
                      <label for="y_is_product_group_3_required" string="Required"/>
                      <field name="y_is_product_group_3_required" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                    <span class="d-inline-block">
                      <label for="y_is_product_group_3_invisible" string="Active"/>
                      <field name="y_is_product_group_3_invisible" widget="boolean_toggle" readonly="y_state in ['locked']" style="padding-left:10px;"/>
                    </span>
                </div>

              </sheet>
              <chatter/>
            </form>
          </field>
        </record>

        <record id="product_group_config_action" model="ir.actions.act_window">
            <field name="name">Product Group Configuration</field>
            <field name="res_model">product.group.config</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_product_group_config"
                    name="Product Group Configuration"
                    action="product_group_config_action"
                    parent="inventory_base.menu_product_group_root"
                    sequence="1"/>

    </data>
</odoo>