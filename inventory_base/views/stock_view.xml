<odoo>

	<record id="stock_account.action_revalue_layers" model="ir.actions.act_window">
        <field name="groups_id" eval="[(4, ref('inventory_base.group_adjust_valuation_access'))]"/>
    </record>

    <record id="stock.action_toggle_is_locked" model="ir.actions.server">
        <field name="groups_id" eval="[Command.link(ref('inventory_base.transfer_lock_unlock_access'))]"/>
    </record>

	<record id="tree_stock_valuation_layer_inherit" model="ir.ui.view">
	    <field name="name">list.stock.valuation.layer.inherit</field>
		<field name="model">stock.valuation.layer</field>
		<field name="inherit_id" ref="stock_account.stock_valuation_layer_tree" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='product_id']" position="after">
			    <field name="y_code"/>
			</xpath>
		</field>
	</record>

	<record id="ir_action_update_operation_type"
		model="ir.actions.server">
		<field name="name">Update Transaction Type</field>
		<field name="model_id" ref="model_stock_valuation_layer" />
		<field name="binding_model_id" ref="model_stock_valuation_layer" />
		<field name="binding_view_types">list</field>
		<field name="state">code</field>
		<field name="code">
			if records:
			action = records.update_operation_type()
		</field>
	</record>
</odoo>