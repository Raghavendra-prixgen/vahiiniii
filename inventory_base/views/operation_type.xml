<odoo>

    <record id="tree_stock_move_inherit" model="ir.ui.view">
        <field name="name">list.stock.move.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="y_operation_type" decoration-danger="(y_operation_type in ('incoming_return','outgoing','consumption','negative_adjustment','in_transit_neg'))" decoration-success = "(y_operation_type in ('incoming','outgoing_return','production','positive_adjustment'))"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="y_valuation_value" sum="Total Valution Value" optional="hide"/>
                <field name="y_is_valuation" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="ir_stock_move_action_update_operation_type"
        model="ir.actions.server">
        <field name="name">Update Transaction Type</field>
        <field name="model_id" ref="model_stock_move" />
        <field name="binding_model_id" ref="model_stock_move" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.update_operation_type()
        </field>
    </record>
    
    <record id="ir_stock_move_action_update_valuation"
        model="ir.actions.server">
        <field name="name">Update Valuation Post</field>
        <field name="model_id" ref="model_stock_move" />
        <field name="binding_model_id" ref="model_stock_move" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.update_valuation()
        </field>
    </record>


</odoo>