<odoo>
    
    <record id="product_classification_tree" model="ir.ui.view">
        <field name="name">product_classification.list</field>
        <field name="model">product.classification</field>
        <field name="arch" type="xml">
            <list string="Product Classification">
              <field name="y_name"/>
              <field name="y_description"/>
              <field name="y_company_id"/>                  
            </list>
        </field>
    </record>
           
    <record id="product_classification_move_form" model="ir.ui.view">
        <field name="name">product_classification.form</field>
        <field name="model">product.classification</field>
        <field name="arch" type="xml">
            <form string="Product Classification">                  
                <sheet>  
                    <group>
                        <field name="y_name"/>
                        <field name="y_description" />
                    </group>
                    <group>
                        <field name="y_company_id" />
                    </group>
                </sheet>                     
            </form>
        </field>
    </record>
    
    <record id="action_product_classification" model="ir.actions.act_window">
        <field name="name">Product Classification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.classification</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem parent="menu_product_group_root" name="Product Classification" id="menu_action_product_classification" action="action_product_classification"/>
   
</odoo>