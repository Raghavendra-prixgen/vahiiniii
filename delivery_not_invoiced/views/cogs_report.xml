<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="view_delivery_not_invoiced_report_list" model="ir.ui.view">
            <field name="name">delivery.not.invoiced.report.list</field>
            <field name="model">delivery.not.invoiced.report</field>
            <field name="arch" type="xml">
                <list string="Delivered Not Invoiced Report" export_xlsx="false">
                    <field name="y_sale_id"/>
                    <field name="y_partner_id"/>
                    <field name="y_invoice_reference"/>
                    <field name="debit" sum="Debit" widget="float" string="Debit"/>
                    <field name="credit" sum="Credit" widget="float" string="Credit"/>
                    <field name="difference" sum="Difference" widget="float" bold="True" color="#ff0000" string="Difference"/>
                    <field name="y_status" widget="badge" decoration-info="y_status== 'partially'" decoration-muted="y_status == 'un_reconciled'" decoration-success="y_status == 'reconciled'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="action_delivery_not_invoiced_report" model="ir.actions.server">
            <field name="name">COGS Interim Register(New)t</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_delivery_not_invoiced_report"/>
            <field name="binding_model_id" eval="False"/>
            <field name="state">code</field>
            <field name="code">action = model.button_view_report()</field>
        </record>

        <record id="view_delivery_not_invoiced_report_filter" model="ir.ui.view">
            <field name="name">delivery.not.invoiced.report.search.view</field>
            <field name="model">delivery.not.invoiced.report</field>
            <field name="arch" type="xml">
                <search string="Search Delivered">
                    <field name="y_sale_id" string="Sale Order"/>
                    <field name="y_partner_id"/>
                    <field name="y_invoice_reference"/>
                    <group expand="0" string="Group By">
                      <filter name="y_status" string="Status" domain="[]" context="{'group_by':'y_status'}"/>
                    </group>
               </search>
            </field>
        </record>


        <menuitem id="menu_action_delivery_not_invoiced_report"
                  name="COGS Interim Register(New)"
                  parent="account_additional_reports.menu_additional_reports"
                  action="action_delivery_not_invoiced_report"
                  sequence="20"/>


    </data>
</odoo>