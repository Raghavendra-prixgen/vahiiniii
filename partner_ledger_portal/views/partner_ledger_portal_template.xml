<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add menu item to portal home page -->
    <template id="portal_my_home_menu_partner_ledger" name="Portal Menu Partner Ledger" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'partner_ledger'" class="breadcrumb-item">
                <a t-attf-href="/my/partner_ledger">Partner Ledger</a>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_quotation_request" name="Portal My Home Quotation Request" inherit_id="portal.portal_my_home" priority="10">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/partner_ledger_portal/static/description/img/ledger_icon1.png'"/>
                <t t-set="title">Ledger</t>
                <t t-set="url" t-value="'/my/partner_ledger'"/>
                <t t-set="text">Your Statement</t>
                <t t-set="placeholder_count" t-value="'ledger_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Main Partner Ledger Template -->
    <template id="portal_partner_ledger" name="Portal Partner Ledger">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Partner Ledger</t>
            </t>

            <div class="row mt-4" style="font-size:14px;">
                <div class="col-lg-12">
                    <form id="partner_ledger_filter_form" class="mb-4 filter-section">
                        <div class="row">
                            <div class="col-lg-3  mb-2">
                                <div class="form-group">
                                    <label for="date_begin">From</label>
                                    <input type="date" name="date_begin" id="date_begin" class="form-control" t-att-value="date_begin"/>
                                </div>
                            </div>
                            <div class="col-lg-3  mb-2">
                                <div class="form-group">
                                    <label for="date_end">To</label>
                                    <input type="date" name="date_end" id="date_end" class="form-control" t-att-value="date_end"/>
                                </div>
                            </div>
                            <div class="col-lg-2  mb-2">
                                <div class="form-group">
                                    <label for="journal_type">Transaction Type</label>
                                    <select name="journal_type" id="journal_type" class="form-control">
                                        <t t-foreach="journal_types" t-as="jt">
                                            <option t-att-value="jt" t-att-selected="jt == journal_type">
                                                <t t-esc="journal_types[jt]"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-2  mb-2">
                                <div class="form-group">
                                    <label for="sortby">Sort By</label>
                                    <select name="sortby" id="sortby" class="form-control">
                                        <t t-foreach="sortby_options" t-as="so">
                                            <option t-att-value="so" t-att-selected="so == sortby">
                                                <t t-esc="sortby_options[so]"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-2 mb-2">
                                <div class="col-lg-9 col-md-6" style="display: contents;">
                                    <button type="button" id="download_pdf_button" class="btn btn-sm text-white fs-5 m-4 " style=" background:#2c3e50; width:125px;">
                                        <i class="fa fa-file-pdf-o me-1"></i>
                                        <span class="">  PDF</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 col-md-6 mb-2 d-flex align-items-end">
                                <div class="form-check">
                                    <input type="checkbox" name="outstanding_only" id="outstanding_only" class="form-check-input" t-att-checked="outstanding_only"/>
                                    <label for="outstanding_only" class="form-check-label">Outstanding Only</label>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div id="partner_ledger_table_container">
                        <t t-call="partner_ledger_portal.portal_partner_ledger_lines"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_partner_ledger_lines" name="Portal Partner Ledger Lines">
        <div class="table-responsive partner-ledger-table">
            <table class="table table-striped table-hover" style="font-size:14px;">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reference</th>
                        <th>Journal</th>
                        <th>Matching Number</th>                        <!-- Changed from Account -->
                        <th>Due Date</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Add initial balance row -->
                    <tr t-if="ledger_lines and initial_balance is not None" class="initial-balance-row">
                        <td colspan="5">
                            <strong>Initial Balance</strong>
                        </td>
                        <td class="text-end">
                            <!-- No debit for initial balance -->
                        </td>
                        <td class="text-end">
                            <!-- No credit for initial balance -->
                        </td>
                        <td class="text-end">
                            <!-- No amount for initial balance -->
                        </td>
                        <td class="text-end">
                            <strong t-esc="initial_balance" t-options='{"widget": "monetary", "display_currency": company_currency}'/>
                        </td>
                    </tr>
                    <t t-if="ledger_lines">
                        <!-- <t t-foreach="ledger_lines" t-as="line">
                            <tr>
                                <td>
                                    <span t-if="line['date']" t-esc="line['date']" t-options='{"widget": "date", "format": "dd/MM/yyyy"}' />
                                </td>
                                <td>
                                    <t t-if="line['move_id']">
                                        <a t-att-href="'/my/invoices/%s' % line['move_id'] if line['move_type'] in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'] else '#'">
                                            <t t-esc="line['move_name']"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="line['name']"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-esc="line['journal_name']"/>
                                </td>
                                <td>
                                    <t t-esc="line['account_name']"/>
                                </td>
                                <td>
                                    <span t-if="line['due_date']" t-esc="line['due_date']" t-options='{"widget": "date", "format": "dd/MM/yyyy"}' t-att-class="line['is_overdue'] and 'text-danger'" />
                                </td>
                                <td class="text-end">
                                    <span t-if="line['debit']" t-esc="line['debit']" t-options='{"widget": "monetary", "display_currency": line["company_currency"]}' class="debit-amount"/>
                                </td>
                                <td class="text-end">
                                    <span t-if="line['credit']" t-esc="line['credit']" t-options='{"widget": "monetary", "display_currency": line["company_currency"]}' class="credit-amount"/>
                                </td>
                                <td class="text-end">
                                    <t t-if="line['currency'] != line['company_currency']">
                                        <span t-esc="line['currency_symbol']"></span>
                                        <span t-esc="line['amount_currency']" />
                                    </t>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['running_balance']" t-options='{"widget": "monetary", "display_currency": line["company_currency"]}' />
                                </td>
                            </tr>
                        </t> -->

                        <t t-foreach="ledger_lines" t-as="line">
                            <tr>
                                <td>
                                    <span t-if="line['date']" t-esc="line['date']" t-options='{"widget": "date", "format": "dd/MM/yyyy"}' />
                                </td>
                                <td>
                                    <t t-if="line['move_id']">
                                        <a t-att-href="'/my/invoices/%s' % line['move_id'] if line['move_type'] in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'] else '#'">
                                            <t t-esc="line['move_name']"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="line['name']"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-esc="line['journal_name']"/>
                                </td>
                                <td>
                                    <span class="" t-esc="line['matching_number']"/>
                                    <!-- Changed from account_name -->
                                </td>
                                <td>
                                    <span t-if="line['due_date']" t-esc="line['due_date']" t-options='{"widget": "date", "format": "dd/MM/yyyy"}' t-att-class="line['is_overdue'] and 'text-danger'" />
                                </td>
                                <td class="text-end">
                                    <span t-if="line['debit']" t-esc="line['debit']" t-options='{"widget": "monetary", "display_currency": line["company_currency"]}' class="debit-amount"/>
                                </td>
                                <td class="text-end">
                                    <span t-if="line['credit']" t-esc="line['credit']" t-options='{"widget": "monetary", "display_currency": line["company_currency"]}' class="credit-amount"/>
                                </td>
                                <td class="text-end">
                                    <t t-if="line['currency'] != line['company_currency']">
                                        <span t-esc="line['currency_symbol']"></span>
                                        <span t-esc="line['amount_currency']" />
                                    </t>
                                </td>
                                <td class="text-end">
                                    <span t-esc="line['running_balance']" t-options='{"widget": "monetary", "display_currency": line["currency"]}' />
                                </td>
                            </tr>
                        </t>

                        <tr class="table-totals-row">
                            <td colspan="5" class="">
                                <strong>Totals:</strong>
                            </td>
                            <td class="text-end">
                                <strong class="debit-amount">
                                    <t t-if="totals.get('currency')">
                                        <span t-esc="totals['total_debit']" t-options='{"widget": "monetary", "display_currency": totals["currency"]}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="totals['total_debit']"/>
                                    </t>
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong class="credit-amount">
                                    <t t-if="totals.get('currency')">
                                        <span t-esc="totals['total_credit']" t-options='{"widget": "monetary", "display_currency": totals["currency"]}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="totals['total_credit']"/>
                                    </t>
                                </strong>
                            </td>
                            <td class="text-end">

                            </td>
                            <td class="text-end">
                                <strong>
                                    <t t-if="totals.get('currency')">
                                        <span t-esc="totals['final_balance']" t-options='{"widget": "monetary", "display_currency": totals["currency"]}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="totals['final_balance']"/>
                                    </t>
                                </strong>
                            </td>
                        </tr>
                    </t>
                    <tr t-if="not ledger_lines">
                        <td colspan="9" class="text-center">No transactions found</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="o_portal_pager">
            <t t-call="portal.pager"/>
        </div>
    </template>
</odoo>
