<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================# Purchase Approval Configuration #======================= -->

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('y_order_type', '!=', 'blanket'),('state', 'in', ('draft', 'sent', 'cancel','reject','to_approve'))]</field>
    </record>

    <record id="sale_doc_approval_required_tree" model="ir.ui.view">
        <field name="name">sale.doc.type.approval.list</field>
        <field name="model">sale.doc.type</field>
        <field name="inherit_id" ref="sale_base_18.sale_doc_teype_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='y_company_id']" position="after">
                <field name="y_is_approval_required" widget="boolean_toggle" string="Approval Required"/>
            </xpath>
        </field>
    </record>

    <record id="sale_doc_type_view_approval_required_form" model="ir.ui.view">
        <field name="name">sale.doc.type.approval.form</field>
        <field name="model">sale.doc.type</field>
        <field name="inherit_id" ref="sale_base_18.sale_doc_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='y_company_id']" position="after">
                <field name="y_is_approval_required" widget="boolean_toggle" string="Approval Required"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_approval_form" model="ir.ui.view">
        <field name="name">sale.approval.form</field>
        <field name="model">sale.approval</field>
        <field name="arch" type="xml">
          <form string="Sales Approval" >
            <sheet>
                <group>
                    <group>
                        <field name="y_company_id" invisible="1"/>
                        <field name="y_parent_company_id" invisible="1"/>
                        <field name="y_document_type_id" required="1" options="{'no_create': True, 'no_open': True}" domain="['|','|','|',('y_company_id', '=', False),('y_company_id', 'child_of', y_company_id),('y_company_id', '=', y_company_id),('y_company_id', '=', y_parent_company_id)]"/>
                        <field name="y_name" />
                    </group>
                    <group>
                        <field name="y_company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" groups="base.group_multi_company" required="1"/>
                        <field name="y_currency_id" options="{'no_create': True, 'no_create_edit':True,'no_open':True}" required="1"/>
                    </group>
                <group>
                </group>
                </group>
                    <notebook>
                        <page string="Approvals" name="lvlandamount">
                            <field name="y_lvl_amt_approval_lines" widget="section_and_note_one2many" >
                                <list string="Lvl and Amt Approval Lines" editable="bottom">
                                    <field name='y_approval_level' required="1"/>
                                    <field name='y_approval_amount_from' required="1"/>
                                    <field name='y_approval_amount_to' required="1"/>
                                    <field name='y_lvl1_user_id' options="{'no_create': True, 'no_open': True}" required="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval','4thlvlapproval','5thlvlapproval')"/>
                                    <field name='y_lvl2_user_id' options="{'no_create': True, 'no_open': True}" required="y_approval_level in ('2ndlvlapproval','3rdlvlapproval','4thlvlapproval','5thlvlapproval')" force_save="1" readonly="y_approval_level == '1stlvlapproval'"/>
                                    <field name='y_lvl3_user_id' options="{'no_create': True, 'no_open': True}" required="y_approval_level in ('3rdlvlapproval','4thlvlapproval','5thlvlapproval')" force_save="1" readonly="y_approval_level in ('1stlvlapproval','2ndlvlapproval')"/>
                                    <field name='y_lvl4_user_id' options="{'no_create': True, 'no_open': True}" required ="y_approval_level in ('4thlvlapproval','5thlvlapproval')" force_save="1" readonly ="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval')"/>
                                    <field name='y_lvl5_user_id' options="{'no_create': True, 'no_open': True}" force_save="1" readonly ="y_approval_level in ('1stlvlapproval','2ndlvlapproval','3rdlvlapproval','4thlvlapproval')" required="y_approval_level == '5thlvlapproval'"/>
                                    
                                    <field name='y_lvl_approval_id' column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
            </sheet>
            <chatter/>
          </form>
        </field>
    </record>

    <record id="view_sale_approval_form_tree" model="ir.ui.view">
        <field name="name">sale.approval.list</field>
        <field name="model">sale.approval</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <list string="Sales Approval" >
                <field name="y_name"/>
                <field name="y_document_type_id"/>
                <field name="y_company_id"/>
                <field name="y_currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sale_approval_search_view" model="ir.ui.view">
        <field name="name">sale.approval.search</field>
        <field name="model">sale.approval</field>
        <field name="arch" type="xml">
            <search>
                <field name="y_document_type_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record model="ir.rule" id="sale_approval_record_restricted_company_rule">
        <field name="name">Sale Approval Restricted Record: multi-company</field>
        <field name="model_id" ref="model_sale_approval"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('y_company_id', '=', False), ('y_company_id', 'parent_of', company_ids)]
        </field>
    </record>

   

    <record id="action_sale_approval" model="ir.actions.act_window">
        <field name="name">Approval Setting SO</field>
        <field name="res_model">sale.approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
        id="menu_sale_approval" 
        name="Approval Setting SO" 
        parent="sale_base_18.menu_config_sale_others"
        action="action_sale_approval" sequence="150"
    />

    <!-- ===================# Sale Approval Configuration END #======================= -->


    <!-- ===================# Sale Approval in Sale Order #======================= -->


    <record id="view_order_form_inherit_y_doc_type_id" model="ir.ui.view">
        <field name="name">sale.order.form.doc.type</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_base_18.view_order_form_inherit"/>
        <field name="arch" type="xml">
            <field name="y_doc_type_id" position="attributes">
                <attribute name="readonly">state in ['cancel','to_approve','sale','reject']</attribute>
            </field>
        </field>
    </record>

    <record id="sale_order_SO_approval" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="order_line" position="attributes">
                <attribute name="readonly">state in ('cancel','to_approve','sale','reject') or locked</attribute>
            </field>            
            <button name="action_draft" position="attributes">
                <attribute name="invisible">state not in ('to_approve','reject')</attribute>
            </button>
            <button name="action_draft" position="after" >
                <button name="get_approval_data" type="object" class="oe_highlight" invisible="state not in ('sent','draft') or y_is_approval_required == False" string="Request for Approval" context="{'validate_analytic': True}"/>
                <button name="confirm_approval" type="object" class="oe_highlight" invisible="state != 'to_approve'" string="Approve" context="{'validate_analytic': True}"/>
                <field name="y_is_approval_required" invisible="1"/>
                <button name="%(sale_approval_18.action_sale_approval_remarks)d" type="action" class="oe_highlight" string="Reject" invisible="state != 'to_approve'"/>
            </button>

            <field name="currency_id" position='after'>
                <field name="y_to_approve_states" invisible="1"/>
                <field name="y_is_approval_show" invisible="1"/>
            </field>
            <field name="state" invisible="1"/>
            <notebook position="inside">

                <page string="Approvals" invisible="y_is_approval_show == False">
                    <field name='y_sale_lvl_amt_approval_line' widget="section_and_note_one2many" readonly="1">
                        <list>
                            <field name='y_approval_level'/>
                            <field name='y_lvl_user_id' widget="badge" decoration-success="1"/>
                            <button name="view_code_users" type="object" string="" icon="fa-eye" class="btn-secondary" help="View Users" />
                            <field name="y_approved_date"/>
                            <field name="y_approver_id"/>
                            <field name='y_sale_lvl_id' column_invisible="True"/>
                            <field name="y_approval_status" widget="badge" decoration-success="y_approval_status == 'approved'" decoration-primary="y_approval_status == 'approval_pending'" decoration-info="y_approval_status == 'rejected'"/>
                            <field name="y_is_approval_completed" string="Approval Completed" column_invisible="True"/>
                            <field name="y_remarks"/>
                        </list>
                    </field>
                </page>
             </notebook>
            </field>
    </record>

    <record id="sale_order_tree_view_newx" model="ir.ui.view">
        <field name="name">sale.order.list.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="y_to_approve_states" widget="badge"/>
            </field>
        </field>
    </record>


</odoo>
