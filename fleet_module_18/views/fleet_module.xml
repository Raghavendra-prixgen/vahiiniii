    <record id="fleet_res_config_settings_view_form_transport" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base.setup</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="fleet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@id='fleet']" position="inside">
                <block title="Transportation Order" id="end_contract_settingss">
                <setting string="Vehicle Indent Sequence">
                    <div class="text-muted content-group mt16">        
                        <field name="y_vehicle_intent_sequence_id" />
                    </div> 
                </setting>
                <setting string="Service Product">
                    <div class="text-muted content-group mt16">      
                        <field name="y_transportation_product_id" domain="[('type','=','service')]"/>
                    </div> 
                </setting>
                <setting string="Transporation Order Sequence">
                    <div class="text-muted content-group mt16">      
                        <field name="y_transportation_order_sequence_id" />
                    </div>
                </setting>
                <setting string="Landed Cost Journal">
                    <div class="text-muted content-group mt16">     
                        <field name="y_transportation_journal_id" />
                    </div>
                </setting>
                
                <setting string="Freight Cost Master Sequence">
                    <div class="text-muted content-group mt16">     
                        <field name="y_freight_cost_master_sequence_id" />
                    </div>
                </setting>

                <setting string="Transporation Order Approver">
                    <div class="text-muted content-group mt16">     
                        <field name="y_transportation_order_approver_ids" widget="many2many_tags"/>
                    </div>
                </setting>
                
                
            </block>
            </xpath>
        </field>
    </record>

</odoo>
