<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Login -->
        <!-- Login Form view -->
        <record model="ir.ui.view" id="gate_management_login_form_view">
            <field name="name">gate_management.login.form</field>
            <field name="model">gate.user.login</field>
            <field name="arch" type="xml">
                <form style="margin:0 auto;width:400px;height:100px">
                    <sheet>
                        <div col="2" >
                            <group>
                                <field name="y_username" required="1" />
                                <field name="y_password" password="True" required="1" />
                            </group>
                            <group>
                                <button name="login" string="Login" type="object"
                                    context="{'user':y_username}" class="oe_highlight" />
                            </group>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Registration-->
        <!-- Registration form view-->
        <record id="gate_management_registration_form_view" model="ir.ui.view">
            <field name="name">gate_management_registration_form</field>
            <field name="model">gate.user.registration</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="y_username" required="1" />
                            <field name="y_password" password="True" required="1" />
                            <field name="y_warehouse_id"
                                options="{'no_create':True, 'no_create_edit':True }" />
                            <field name="y_is_head_security" />
                            <field name='y_user_id' readonly='1' />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Registration Tree view -->
        <record id="gate_management_registration_view" model="ir.ui.view">
            <field name="name">gate_management_registration_form</field>
            <field name="model">gate.user.registration</field>
            <field name="arch" type="xml">
                <list editable="bottom"
                    create="1" edit="1" delete="0">
                    <field name="y_username" />
                    <field name="y_password" password="True" />
                    <field name="y_warehouse_id" options="{ 'no_create':True, 'no_create_edit':True }" />
                    <field name="y_is_head_security" />
                    <field name="y_user_id" options="{ 'no_create':True, 'no_create_edit':True }"/>
                </list>
            </field>
        </record>


        <!-- Action panel -->
        <!-- Login -->
        <record model="ir.actions.act_window" id="gate_management.action_window_login">
            <field name="name">Login</field>
            <field name="res_model">gate.user.login</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
        </record>

        <!-- Registration -->
        <record model="ir.actions.act_window" id="gate_management.action_window_registration">
            <field name="name">Registration</field>
            <field name="res_model">gate.user.registration</field>
            <field name="view_mode">list</field>
        </record>


        <!-- Menuitem panel -->
        <menuitem name="Login" id="gate_management.login"
            action="gate_management.action_window_login"
            parent="gate_management.menu_3" />

        <menuitem name="Registration" id="gate_management.registration"
            parent="gate_management.menu_3"
            action="gate_management.action_window_registration"
            groups='gate_management.group_gate_management_access' />

    </data>
</odoo>