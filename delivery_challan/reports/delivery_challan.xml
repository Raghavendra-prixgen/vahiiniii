                                            <strong>UOM</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="i" t-value="1" />
                                    <t t-set="total_qty" t-value="0" />
                                    <t t-set="total_deliverd_qty" t-value="0" />
                                    <t t-foreach="doc.move_ids_without_package" t-as="line">
                                        <tr style="font-size:12px;">
                                            <td class="text-center" style="width:4%;border:1px solid black;padding:1px;width:5%;">
                                                <span t-esc="i" />
                                                <t t-set="i" t-value="i+1" />
                                            </td>
                                            <td class="text-left" style="width:70%;padding-left: 3%;border:1px solid black;font-size:12px;padding:3px;width:35%;">
                                                <span t-field="line.product_id.name" />
                                            </td>
                                            <td class="text-center" style="width:20%;padding-right: 3%;border:1px solid black;padding:3px;width:25;">
                                                <span t-field="line.quantity" />
