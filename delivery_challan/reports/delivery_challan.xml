                                            </td>
                                            <td class="text-center" style="width:30%;border:1px solid black;padding:1px;width:25%;">
                                                <span t-esc="line.product_uom.name" />
                                            </td>
                                        </tr>
                                    </t>
                                    <tr style="font-size:12px;">
                                        <td colspan="2" class="text-left" style="border:1px solid black;width:40">
                                            <strong>Total Quantity:</strong>
                                        </td>
                                        <td class="text-right" style="text-align:center;border:1px solid black;width:25%">
                                            <strong>
                                                <span t-esc="'%.2f'%(total_deliverd_qty)" />
                                            </strong>
                                        </td>
                                        <td class="text-right" style="border:1px solid black;width:25%"> </td>
