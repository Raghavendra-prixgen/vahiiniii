<odoo>
    <data>
        <record id="delivery_challan_report_vahini" model="report.paperformat">
            <field name="name">delivery challan report page format</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">38</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">30</field>
            <field name="dpi">91</field>
        </record>
        <record id="delivery_challan" model="ir.actions.report">
            <field name="name">Delivery Challan Report </field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">delivery_challan.delivery_challan_report_template</field>
            <field name="report_file">delivery_challan.delivery_challan_report_template</field>
            <field name="print_report_name"> (object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking" />
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="delivery_challan.delivery_challan_report_vahini" />
        </record>

        <template id="delivery_challan_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="delivery_challan.external_layout_delivery_challan_vahini">
                        <!-- <div class="page">
                            <table colspan="7" class="table-borderless table-sm m-0 p-0 " style="border:1px solid black;border-top:none;width:100%;page-break-inside:avoid;">
