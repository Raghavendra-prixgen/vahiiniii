<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_partner_tds_lines" model="ir.ui.view">
            <field name="name">res.partner.inherit.lines</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="property_account_receivable_id" position="before">
                    <field name="y_wtax_applicable" widget="boolean_toggle"/>
                </field>


                <xpath expr="//notebook[last()]" position="inside">
                    <page string="Withholding Tax" name="tds_deduction" invisible="y_wtax_applicable != True">
                        <field name="y_tds_lines">
                          <list editable="bottom">
                            <field name="y_start_date" requred="1"/>
                            <field name="y_end_date" requred="1"/>
                            <field name="y_is_concession_applicable" />

                            <field name="y_nature_of_deduction_id" options="{'no_create': True, 'no_create_edit':True,'no_open': True}"/>
                            <field name="y_section_id" options="{'no_create': True, 'no_create_edit':True,'no_open': True}"/>
                            <field name="y_tax_code" options="{'no_create': True, 'no_create_edit':True,'no_open': True}"/>
                            <field name="y_recipent_type" force_save="1"/>

                            <field name="y_tds_tax_ids" domain="[('tax_group_id', '=', 'TDS'),('company_id', 'in', (False, y_company_id))]" widget="many2many_tags"/>
                            <field name="y_tds_master_id" optional="hide"/>
                            <field name="y_product_ids" widget="many2many_tags" column_invisible="0"/>
                            <field name="y_account_ids" widget="many2many_tags"  column_invisible="0"/>
                            
                          </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>


        <record id="tds_master_account_move_view_form" model="ir.ui.view">
        <field name="name">account.moveform.tds.advanced</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <xpath expr="//header" position="inside">

            <button name="calcluate_tds" type='object' string="Simulate TDS" class="oe_highlight" invisible="state == 'posted'"
            />

        </xpath>
            
        
        </field>
    </record>

    <record model="ir.ui.view" id="view_tds_master_form">
    <field name="name">tds.master.form</field>
    <field name="model">tds.master</field>
    <field name="arch" type="xml">
      <form >
        <sheet>
          <group>
            <group>
              <field name="y_tax_type" />
              <field name="y_nature_of_deduction_id" />
              <field name="y_section_id" />
              <field name="y_recipent_type" />
              <field name="y_company_id"/>
              
            </group>
            <group>

              <field name="y_concession_code_id" />
              <field name="y_tax_code" />
              <field name="y_tax_ids" options="{'no_create': True, 'no_create_edit':True,'no_open': True}" widget="many2many_tags" domain="[('tax_group_id', '=', 'TDS'),('company_id', 'in', (False, y_company_id))]"  />
              <field name="y_without_pan_tax_ids" options="{'no_create': True, 'no_create_edit':True,'no_open': True}" domain="[('tax_group_id', '=', 'TDS'),('company_id', 'in', (False, y_company_id))]" widget="many2many_tags"/>
              <field name="y_per_transcation" />
              <field name="y_aggregate_limit" />

            </group>
          </group>
          <notebook>
            <page name="Service Master">
            <field name="y_product_ids">
              <list editable="bottom">
                <field name="name" />
               
              </list>
            </field>



             
            </page>

            <page name="General Ledger">
            <field name="y_account_ids"  >
              <list editable="bottom">
                <field name="name" />
               
              </list>
            </field>



             
            </page>
          </notebook>
        </sheet>
        <chatter/>

       
      </form>
    </field>
    </record>




    <record id="view_tax_form_inherit_tds" model="ir.ui.view">
      <field name="name">account.tax.form.inherit.tds</field>
      <field name="model">account.tax</field>
      <field name="inherit_id" ref="account.view_tax_form"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='tax_scope']" position="after">
              <field name="y_tax_code"/>
          </xpath>
      </field>
  </record>

    <record id="view_tds_master_tree" model="ir.ui.view">
        <field name="name">tds.master.tree</field>
        <field name="model">tds.master</field>
        <field name="arch" type="xml">
            <list editable="top" create="1" delete="1" multi_edit="1" string="TDS Master" open_form_view="True">

                <field name="y_effective_date"/>
                <field name="y_section_id" />
                <field name="y_tax_code" options="{'no_create': True, 'no_create_edit':True,'no_open': True}"/>
                <field name="y_contract_value"/>
                <field name="y_threshold_value"/>
                <field name="y_turnover"/>
                <field name="y_per_transcation" optional="hide"/>
                <field name="y_aggregate_limit" optional="hide"/>
                <field name="y_concession_code_id"/>
                <field name="y_concession_tax_ids" domain="[('tax_group_id', '=', 'TDS'),('company_id', 'in', (False, y_company_id))]" options="{'no_create': True, 'no_create_edit':True,'no_open': True}" widget="many2many_tags"/>
                <field name="y_tax_ids" domain="[('tax_group_id', '=', 'TDS'),('company_id', 'in', (False, y_company_id))]" options="{'no_create': True, 'no_create_edit':True,'no_open': True}" widget="many2many_tags"/>
                <field name="y_without_pan_tax_ids" domain="[('tax_group_id', '=', 'TDS'),('company_id', 'in', (False, y_company_id))]" options="{'no_create': True, 'no_create_edit':True,'no_open': True}" widget="many2many_tags"/>


               
            </list>
        </field>
    </record>

    



    <record model="ir.actions.act_window" id="automatic_tds_master_action_window">
        <field name="name">Withholding Tax</field>
        <field name="res_model">tds.master</field>
        <field name="view_mode">list,form</field>
      </record>

    <menuitem id="menu_tds_master" name="Withholding Tax" parent="account.menu_finance_entries"  action="automatic_tds_master_action_window"/>
        
    </data>
</odoo>