<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tds_payment_form" model="ir.ui.view">
        <field name="name">tds.payment.form</field>
        <field name="model">tds.payment</field>
        <field name="arch" type="xml">
            <form string="Challan 281">
                <header>
                    <button string="Post" name="action_post" type="object"
                        invisible="y_state == 'posted'" />
                    <button string="Reset to draft" name="action_draft" type="object"
                        invisible="y_state == 'draft'"
                        groups="tds_functionality.access_for_reset_to_draft" />
                    <field name="y_state" widget="statusbar" statusbar_visible="draft,posted" />
                    <button name="download_json_format"
                        string="Download JSON"
                        type="object"
                        class="btn-primary"
                        invisible="y_state != 'posted'" />
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="y_doc_no" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="y_month" readonly="y_state == 'posted'" />
                            <field name="y_year" readonly="y_state == 'posted'" />
                        </group>
                        <group>
                            <field name="y_original" widget="boolean_toggle"
                                readonly="y_state == 'posted'" />
                            <field name="y_reversed" widget="boolean_toggle"
                                readonly="y_state == 'posted'" />
                            <field name="y_payment_ids"
                                widget="many2many_tags"
                                domain="[('state', '=', 'posted'), ('payment_type', '=', 'outbound')]"
                                readonly="y_state == 'posted'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="TDS Payment">
                            <field name="y_tds_payment_line_ids" readonly="y_state == 'posted'"
                                widget="one2many" mode="list">
                                <list editable="bottom">
                                    <field name="y_tds_payment_id" column_invisible="True" />
                                    <field name="y_tds_nature_id" options="{'no_create': True, 'no_create_edit':True,'no_open': True}"/>
                                    <field name="y_tds_tax_ids"/>
                                    <field name="y_amount" />
                                    <field name="y_brc" />
                                    <field name="y_challan_no" />
                                    <field name="y_filling" />
                                    <field name="y_token_number" />
                                    <field name="y_matched" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_tds_payment_tree" model="ir.ui.view">
        <field name="name">tds.payment.tree</field>
        <field name="model">tds.payment</field>
        <field name="arch" type="xml">
            <list string="Challan 281">
                <field name="y_doc_no" />
                <field name="y_month" />
                <field name="y_year" />
                <field name="y_original" />
                <field name="y_reversed" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="tds_payment_action_window">
        <field name="name">Challan 281</field>
        <field name="res_model">tds.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
    id="menu_tds_payment"
    name="TDS Payment"
    parent="account_additional_reports.menu_additional_reports"
    action="tds_payment_action_window"
    sequence="10"/>

