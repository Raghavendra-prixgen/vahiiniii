<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="inherit_product_template_only_form_view" model="ir.ui.view">
            <field name="name">product.template.only.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_tag_ids']" position="after">
                    <field name="y_alternate_uom" readonly='0' string="Alternate UOM" groups="uom.group_uom"
                        options="{'no_create': True}" />
                    <field name="y_conversion" string="Conversion" groups="uom.group_uom"/>
                </xpath>

            </field>
        </record>
        
        <record model="ir.ui.view" id="view_stock_quant_tree_inherit">
            <field name="name">stock.quant.tree</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
            <field name="arch" type="xml">
                <list>
                    <field name="quantity" position="before" />
                    <field name="y_quantity_alt_uom" sum="quantity" readonly="1" force_save="1"/>
                    <field name="y_alternate_uom_id" readonly="1" force_save="1"/>
                </list>
            </field>
        </record>
      
        <record model="ir.ui.view" id="view_account_move_line_tree_inherit1">
            <field name="name">account.move.line1</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//form//sheet//notebook/page/field[@name='invoice_line_ids']//list/field[@name='product_uom_id']" position="after">
                    <field name="y_quantity_alt_uom" sum="quantity"  force_save="1" readonly="1" optional="hide"/>
                    <field name="y_alternate_uom"  readonly="1" forece_save="1" optional="hide"/>
                </xpath>
                
            </field>
        </record>

        <record model="ir.ui.view" id="view_form_sale_order_inherit">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//form//sheet//notebook/page/field[@name='order_line']//list/field[@name='product_uom'][2]" position="after">
                    <field name="y_quantity_alt_uom" optional="hide" readonly="1" force_save="1" />
                    <field name="y_alternate_uom" optional="hide" readonly="1" force_save="1"/>
                </xpath>
            </field> 
        </record>

        <record model="ir.ui.view" id="view_form_stock_move_inherit">
            <field name="name">stock.move.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <xpath expr="//form//sheet//notebook/page/field[@name='move_ids_without_package']//list/field[@name='product_uom']" position="after">
                    <field name="y_quantity_alt_uom" optional="show" readonly="1" force_save="1"/>
                    <field name="y_alternate_uom"  optional="show" readonly="1" force_save="1"/>
                </xpath>
            </field> 
        </record>

        <record model="ir.ui.view" id="view_form_stock_move_line_inherit">
            <field name="name">stock.picking.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='quantity']" position="after">

                    <field name="y_alternate_uom"  optional="show" readonly="1" force_save="1"/>
                    <field name="y_quantity_alt_uom" optional="show" readonly="1" force_save="1"/>
                </xpath>
            </field> 
        </record>
        <record model="ir.ui.view" id="view_form_mrp_production_inherit1">
            <field name="name">mrp.production.form.inherit1</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//form//field[@name='user_id']" position="after">
                    <label for="y_quantity_alt_uom"/>
                    <div class="o_row">
                        <field name="y_quantity_alt_uom" string="AUOM QTY" readonly="1" force_save="1"/>
                        <field name="y_alternate_uom" readonly="1" force_save="1" />
                    </div>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>